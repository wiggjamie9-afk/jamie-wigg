# Copy to .env and fill in. .env is gitignored.

# Your DNS A-record must point this hostname to the VPS public IP before `docker compose up`.
DOMAIN=wiki.rhythmix.example

# Used by Caddy for Let's Encrypt account registration + expiry notices.
ADMIN_EMAIL=you@example.com

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-me-with-a-strong-random-string
