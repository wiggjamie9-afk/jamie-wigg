# ===========================================================================
# RHYTHMIX self-hosted stack — environment
# Copy to .env (gitignored) and fill in. Generate secrets with:
#   openssl rand -base64 32     (passwords / tokens)
#   openssl rand -hex 32        (hex keys)
# ===========================================================================

# --- Required: domain + ACME contact ---------------------------------------
# Apps are served at <sub>.${DOMAIN} — point a WILDCARD DNS A-record
#   *.example.com -> <your VPS IP>   so every subdomain resolves.
DOMAIN=example.com
ADMIN_EMAIL=you@example.com

# Timezone (used by n8n and others)
TZ=UTC

# --- Shared Postgres (Miniflux / Gitea / Umami) ----------------------------
POSTGRES_PASSWORD=

# --- Vaultwarden (password manager) ----------------------------------------
# Set SIGNUPS to false after you create your first account.
VAULTWARDEN_SIGNUPS=true
# Admin panel token (https://vault.${DOMAIN}/admin). Generate one:
VAULTWARDEN_ADMIN_TOKEN=

# --- Linkding (bookmarks) — first-run superuser ----------------------------
LINKDING_USER=admin
LINKDING_PASSWORD=

# --- Miniflux (RSS) — first-run admin --------------------------------------
MINIFLUX_USER=admin
MINIFLUX_PASSWORD=

# --- Chhoto URL (shortener) admin password ---------------------------------
CHHOTO_PASSWORD=

# --- Readeck (read-it-later) -----------------------------------------------
READECK_SECRET_KEY=

# --- Open WebUI (AI chat) --------------------------------------------------
OPENWEBUI_SECRET_KEY=

# --- Umami (analytics) -----------------------------------------------------
UMAMI_APP_SECRET=

# --- Jellyfin media library (host path) ------------------------------------
# Absolute path on the VPS to your media. Defaults to ./media if unset.
MEDIA_DIR=./media
