{
  "name": "@nucleus/core",
  "version": "0.1.0",
  "description": "Nucleus: AI-powered neuromarketing video generation platform with Mary agent",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch backend/orchestrator/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "setup": "npm install && npm run build",
    "agent:mary": "tsx backend/orchestrator/mary.ts",
    "hermes:setup": "npm install hermes-agent",
    "memory:sync": "tsx backend/memory/cognee-sync.ts"
  },
  "dependencies": {
    "@ecosystem/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "hermes-agent": "^0.9.0"
  }
}
