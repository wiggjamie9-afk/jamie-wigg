# Copy to .env (which is gitignored) and fill in real values.

# Supabase ─ create a project at https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Google Sign In ─ create OAuth clients in Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Stripe ─ publishable key (pk_test_… in dev, pk_live_… in prod)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Backend endpoint that mints a PaymentIntent + EphemeralKey for the customer.
# Point this at a Supabase Edge Function or your own server route.
EXPO_PUBLIC_STRIPE_INTENT_URL=
