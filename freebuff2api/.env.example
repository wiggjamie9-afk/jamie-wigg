# Freebuff2API Configuration

# Server
LISTEN_ADDR=:8080

# Freebuff Backend
UPSTREAM_BASE_URL=https://codebuff.com

# Authentication Tokens (comma-separated)
# Get tokens from: https://freebuff.llm.pm or from Freebuff CLI
AUTH_TOKENS=token1,token2

# Token Management
ROTATION_INTERVAL=6h
REQUEST_TIMEOUT=15m

# Optional: Client API Key Authentication
# If set, clients must provide Authorization: Bearer <key> header
# Leave empty for open access
API_KEYS=

# Optional: HTTP Proxy for Outbound Requests
# Example: http://proxy.company.com:8080
HTTP_PROXY=
