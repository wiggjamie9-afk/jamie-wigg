{
  "name": "capacitor-buddies",
  "version": "1.0.0",
  "description": "Capacitor iOS wrapper for 50 Buddy Apps",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:web": "cp -r ../apps/* www/apps/ && cp ../apps/buddies.html www/index.html",
    "sync": "npx capacitor sync ios",
    "build": "npm run build:web && npm run sync",
    "open:ios": "npx capacitor open ios",
    "test": "echo 'No tests configured yet'"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
