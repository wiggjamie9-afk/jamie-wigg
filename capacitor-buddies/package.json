{
  "name": "50-buddy-apps",
  "version": "1.0.0",
  "description": "Native iOS app shell for 50 buddy apps built with Capacitor",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "cap sync ios",
    "build": "pnpm build:web && pnpm sync",
    "open:ios": "cap open ios",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/microphone": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": "^20.0.0",
    "pnpm": "^9.0.0"
  }
}
