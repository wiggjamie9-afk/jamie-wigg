# Postfox Integration Configuration
# ====================================
# Copy this file to .env and fill in your credentials

# Postfox API Key
# Get your API key from https://www.postfox.io/settings/api
POSTFOX_API_KEY=your_api_key_here

# Optional: Postfox Account ID
POSTFOX_ACCOUNT_ID=your_account_id_here

# Optional: Default timezone for scheduling
POSTFOX_TIMEZONE=UTC

# Optional: Slack webhook for post notifications
POSTFOX_SLACK_WEBHOOK=https://hooks.slack.com/services/your/webhook/url

# Optional: Enable debug logging
POSTFOX_DEBUG=false
