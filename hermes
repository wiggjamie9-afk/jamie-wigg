#!/bin/bash
# Hermes Agent launcher - activates virtual environment and runs Hermes

set -e

# Get the directory this script is in
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Paths
HERMES_ENV="$HOME/.hermes-env"
HERMES_BIN="$HERMES_ENV/bin/hermes"

# Check if venv exists
if [ ! -d "$HERMES_ENV" ]; then
    echo "❌ Hermes environment not found at $HERMES_ENV"
    echo ""
    echo "Setting up Hermes Agent..."
    python3 -m venv "$HERMES_ENV"
    source "$HERMES_ENV/bin/activate"
    pip install --upgrade pip
    pip install hermes-agent
    echo "✅ Hermes Agent installed successfully!"
    echo ""
fi

# Activate venv and run hermes
source "$HERMES_ENV/bin/activate"
exec hermes "$@"
