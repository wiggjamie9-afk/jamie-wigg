---
const buyUrl = "https://wiggjamie.gumroad.com/l/rhythmix-studio";
---
<section class="text-center px-6 pt-20 pb-[70px]" style="background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(124,58,237,.2),transparent);">
  <div class="inline-flex items-center gap-2 bg-[rgba(0,232,135,.1)] border border-[rgba(0,232,135,.4)] text-[#00e887] text-xs font-bold tracking-[2px] uppercase px-[18px] py-2 rounded-full mb-7">
    <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse-dot"></span>Live Now
  </div>
  <h1 class="font-black leading-none tracking-[-2px] mb-6" style="font-size:clamp(40px,10vw,88px);">
    Make music.<br /><em class="brand-gradient-text not-italic">Own everything.</em>
  </h1>
  <p class="text-[#a0a0b0] leading-relaxed max-w-[560px] mx-auto mb-10" style="font-size:clamp(16px,3vw,20px);">
    Generate a professional track in <strong class="text-white">47 seconds</strong>. Master it instantly. Distribute to Spotify. Keep 100% of every dollar you earn.
  </p>
  <div class="flex gap-3 justify-center flex-wrap mb-10">
    <a href={buyUrl} class="gold-gradient text-black text-lg font-black px-9 py-5 rounded-2xl no-underline inline-block shadow-[0_0_30px_rgba(245,192,0,.25)]">Buy Now — $149 →</a>
    <a href={`${import.meta.env.BASE_URL}features`} class="bg-white/[.08] border border-white/[.15] text-white text-base font-bold px-7 py-5 rounded-2xl no-underline inline-block">See All Features</a>
  </div>
  <p class="text-[#555] text-[13px]">One time · <strong class="text-[#a0a0b0]">All future features included</strong> · No subscription ever</p>
</section>
