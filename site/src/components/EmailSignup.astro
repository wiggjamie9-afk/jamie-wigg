---
---
<section class="px-6 pb-[72px] max-w-[860px] mx-auto">
  <div class="bg-[#0d0d0d] border border-white/[.07] rounded-[20px] p-6 mb-4">
    <h3 class="text-[17px] font-extrabold mb-1">See RHYTHMIX in action</h3>
    <p class="text-[#a0a0b0] text-[13px] mb-4">Launch videos ready to post on TikTok, Instagram, YouTube and LinkedIn.</p>
    <a href={`${import.meta.env.BASE_URL}downloads`} class="cyan-gradient text-white text-sm font-bold px-[22px] py-3 rounded-[10px] no-underline inline-block">Watch & Download All Videos →</a>
  </div>
  <div class="bg-white/[.03] border border-white/[.07] rounded-[20px] px-6 py-8 text-center">
    <h3 class="text-xl font-extrabold mb-1.5">Not ready yet?</h3>
    <p class="text-[#a0a0b0] text-sm mb-[18px]">Drop your email and we'll send you the link when it's ready.</p>
    <form action="https://formsubmit.co/jamie28rhythmixapp@yahoo.com" method="POST">
      <input type="hidden" name="_subject" value="RHYTHMIX waitlist signup" />
      <input type="hidden" name="_captcha" value="false" />
      <div class="flex gap-2.5 max-w-[440px] mx-auto">
        <input type="email" name="email" placeholder="your@email.com" required class="flex-1 bg-white/[.08] border border-white/[.15] rounded-[10px] text-white text-base px-4 py-3.5 outline-none placeholder:text-[#444]" />
        <button type="submit" class="purple-gradient text-white text-sm font-extrabold border-none rounded-[10px] px-5 py-3.5 cursor-pointer whitespace-nowrap">Notify Me</button>
      </div>
    </form>
  </div>
</section>
