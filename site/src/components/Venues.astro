---
---
<section class="px-6 pb-[72px] max-w-[860px] mx-auto">
  <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3">Coming Next</div>
  <h2 class="font-black leading-[1.1] mb-10" style="font-size:clamp(28px,5vw,44px);">Perform on any stage</h2>
  <div class="grid grid-cols-2 gap-2.5 mb-5">
    <div class="rounded-2xl aspect-[3/4] relative overflow-hidden flex items-end p-4 border border-[rgba(255,31,90,.2)]" style="background:linear-gradient(180deg,#000 0%,#1a0020 60%,#000 100%);">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[60px] h-[60px] rounded-full bg-white/90 opacity-60" style="box-shadow:0 0 50px 35px rgba(255,100,200,.25);"></div>
      <div class="relative z-[2]">
        <small class="text-[9px] font-bold tracking-[3px] uppercase text-[#555] block mb-0.5">Venue 01</small>
        <strong class="text-[13px] font-extrabold text-white">Disco Club</strong>
      </div>
    </div>
    <div class="rounded-2xl aspect-[3/4] relative overflow-hidden flex items-end p-4 border border-[rgba(245,192,0,.2)]" style="background:linear-gradient(180deg,#000 0%,#120500 60%,#000 100%);">
      <div class="absolute top-[8%] left-1/2 -translate-x-1/2 w-[3px] h-[160px]" style="background:linear-gradient(180deg,rgba(255,200,50,.8),transparent);box-shadow:0 0 25px 15px rgba(255,150,0,.25);"></div>
      <div class="relative z-[2]">
        <small class="text-[9px] font-bold tracking-[3px] uppercase text-[#555] block mb-0.5">Venue 02</small>
        <strong class="text-[13px] font-extrabold text-white">Rock Arena</strong>
      </div>
    </div>
    <div class="rounded-2xl aspect-[3/4] relative overflow-hidden flex items-end p-4 border border-[rgba(245,192,0,.15)]" style="background:linear-gradient(180deg,#000 0%,#1a0800 60%,#000 100%);">
      <div class="absolute top-[15%] left-1/2 -translate-x-1/2 w-[100px] h-[160px]" style="background:radial-gradient(ellipse,rgba(255,200,80,.2) 0%,transparent 70%);"></div>
      <div class="relative z-[2]">
        <small class="text-[9px] font-bold tracking-[3px] uppercase text-[#555] block mb-0.5">Venue 03</small>
        <strong class="text-[13px] font-extrabold text-white">Jazz Lounge</strong>
      </div>
    </div>
    <div class="rounded-2xl aspect-[3/4] relative overflow-hidden flex items-end p-4 border border-[rgba(124,58,237,.3)]" style="background:linear-gradient(180deg,#000 0%,#07001a 60%,#000 100%);">
      <div class="absolute top-[35%] left-1/2 -translate-x-1/2 w-[160px] h-[2px] bg-[rgba(124,58,237,.5)]" style="box-shadow:0 0 16px 6px rgba(124,58,237,.25);"></div>
      <div class="relative z-[2]">
        <small class="text-[9px] font-bold tracking-[3px] uppercase text-[#555] block mb-0.5">Venue 04</small>
        <strong class="text-[13px] font-extrabold text-white">Underground Rave</strong>
      </div>
    </div>
  </div>
  <p class="text-[#555] text-[13px] text-center">Generate your track → choose your venue → watch it come alive in a 3D animated stage. Included in your $149.</p>
</section>
