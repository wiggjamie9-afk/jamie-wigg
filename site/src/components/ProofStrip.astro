---
const proofs = [
  { num: "22", label: "AI Tools" },
  { num: "120+", label: "Platforms" },
  { num: "47s", label: "First Track" },
  { num: "100%", label: "Your Royalties" },
];
---
<div class="flex justify-center gap-8 flex-wrap px-6 py-7 border-t border-b border-white/5">
  {proofs.map(({ num, label }) => (
    <div class="text-center">
      <div class="text-[28px] font-black text-[#f5c000]">{num}</div>
      <div class="text-[11px] text-[#555] uppercase tracking-[2px] mt-0.5">{label}</div>
    </div>
  ))}
</div>
