---
const buyUrl = "https://wiggjamie.gumroad.com/l/rhythmix-studio";
const includes = [
  "Unlimited AI music generation",
  "AI mastering on every track",
  "Distribution to 120+ platforms",
  "100% of your royalties — always",
  "3D venue performances (coming)",
  "Cloud music library (coming)",
  "All future features — forever",
];
---
<div id="buy" class="border border-[rgba(124,58,237,.3)] rounded-3xl px-7 py-14 text-center mx-6 mb-12" style="background:linear-gradient(135deg,#0d0020,#000);">
  <p class="text-base text-[#555] line-through mb-1.5">$399 / year</p>
  <div class="text-[80px] font-black text-[#f5c000] leading-none">$149</div>
  <p class="text-[#a0a0b0] text-[15px] mt-2.5 mb-7">One time. Own it forever.</p>
  <ul class="list-none flex flex-col gap-2 mb-7 max-w-[380px] mx-auto">
    {includes.map((item) => (
      <li class="text-[#a0a0b0] text-sm text-left">
        <span class="text-[#00e887] mr-2">✓</span>{item}
      </li>
    ))}
  </ul>
  <a href={buyUrl} class="gold-gradient text-black text-xl font-black px-10 py-[22px] rounded-2xl no-underline block max-w-[420px] mx-auto text-center mb-3.5" style="box-shadow:0 0 30px rgba(245,192,0,.25);">Buy Now — $149 →</a>
  <p class="text-[#ff1f5a] text-[13px] font-bold mt-3">⚡ Early access pricing — limited spots</p>
</div>
