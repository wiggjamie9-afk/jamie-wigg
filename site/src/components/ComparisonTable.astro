---
import { rows, competitors, type CompetitorKey, type Row } from "../data/comparison";

interface Props {
  show: CompetitorKey[];
}

const { show } = Astro.props;
const cols = show.map(k => competitors[k]);

function valueFor(row: Row, key: CompetitorKey): string {
  return row[key];
}
---
<div class="hidden md:block bg-[#0d0d0d] border border-white/[.08] rounded-[20px] overflow-x-auto">
  <table class="w-full border-collapse">
    <thead>
      <tr>
        <th class="text-left text-[11px] font-bold tracking-[2px] uppercase text-[#555] px-4 py-4 border-b border-white/[.08]">Feature</th>
        <th class="text-center text-xs font-extrabold uppercase px-4 py-4 border-b border-white/[.08] border-l border-l-white/[.08]">
          <span class="brand-gradient-text">RHYTHMIX</span>
        </th>
        {cols.map(c => (
          <th class="text-center text-[13px] font-bold text-[#a0a0b0] px-4 py-4 border-b border-white/[.08] border-l border-l-white/[.04]">
            {c.name}{c.subtitle && <><br /><span class="text-[10px] font-normal text-[#555]">{c.subtitle}</span></>}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr class={row.highlight ? "bg-[rgba(245,192,0,.04)]" : ""}>
          <td class="px-4 py-3.5 text-[13px] font-semibold text-white border-b border-white/[.04]">{row.label}</td>
          <td class={`px-4 py-3.5 text-[13px] text-center border-b border-white/[.04] border-l border-l-white/[.08] ${row.highlight ? "text-[#f5c000] font-extrabold" : "text-white font-semibold"}`}>{row.rhythmix}</td>
          {cols.map(c => (
            <td class="px-4 py-3.5 text-[13px] text-center text-[#a0a0b0] border-b border-white/[.04] border-l border-l-white/[.04]">
              {valueFor(row, c.key)}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<div class="md:hidden flex flex-col gap-2.5">
  {rows.map(row => (
    <div class={`rounded-2xl px-4 py-4 border ${row.highlight ? "border-[rgba(245,192,0,.25)] bg-[rgba(245,192,0,.04)]" : "border-white/[.08] bg-[#0d0d0d]"}`}>
      <div class="text-[10px] font-bold tracking-[2.5px] uppercase text-[#555] mb-3">{row.label}</div>
      <div class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2 text-[13px]">
        <div class="brand-gradient-text font-extrabold text-[12px]">RHYTHMIX</div>
        <div class={`text-right font-bold ${row.highlight ? "text-[#f5c000]" : "text-white"}`}>{row.rhythmix}</div>
        {cols.map(c => (
          <>
            <div class="text-[#a0a0b0]">{c.name}</div>
            <div class="text-right text-[#a0a0b0]">{valueFor(row, c.key)}</div>
          </>
        ))}
      </div>
    </div>
  ))}
</div>
