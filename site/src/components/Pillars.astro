---
const pillars = [
  { icon: "🎵", title: "Generate", desc: "Type a vibe. Get a full professional track in under a minute. Any genre." },
  { icon: "🎛️", title: "Master", desc: "Every track auto-mastered to streaming standard. Sounds like a $500 session." },
  { icon: "🌍", title: "Distribute", desc: "One tap to Spotify, Apple Music, TikTok, YouTube Music and 120+ more." },
  { icon: "💰", title: "Earn", desc: "100% of your royalties, forever. No label cut. No platform cut. All yours." },
];
---
<section class="px-6 py-[72px] max-w-[860px] mx-auto">
  <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3">What You Get</div>
  <h2 class="font-black leading-[1.1] mb-10" style="font-size:clamp(28px,5vw,44px);">Everything. One price.</h2>
  <div class="grid gap-px bg-white/[.06] rounded-[20px] overflow-hidden" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
    {pillars.map(({ icon, title, desc }) => (
      <div class="bg-black px-5 py-7">
        <div class="text-[28px] mb-3">{icon}</div>
        <h3 class="text-[17px] font-extrabold mb-1.5">{title}</h3>
        <p class="text-[#a0a0b0] text-[13px] leading-[1.55]">{desc}</p>
      </div>
    ))}
  </div>
</section>
