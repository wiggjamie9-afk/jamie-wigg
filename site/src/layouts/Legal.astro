---
import "../styles/global.css";

interface Props {
  title: string;
  updated: string;
  summaryColor?: "gold" | "green";
}

const { title, updated, summaryColor = "gold" } = Astro.props;

const summaryClasses = summaryColor === "green"
  ? "border-[rgba(0,232,135,.4)] bg-gradient-to-br from-[rgba(0,232,135,.1)] to-[rgba(0,232,135,.02)]"
  : "border-white/[.07] bg-[#0d0d0d]";
const summaryHeading = summaryColor === "green" ? "text-[#00e887]" : "text-[#f5c000]";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — RHYTHMIX</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body class="leading-relaxed">
    <nav class="flex justify-between items-center px-6 py-5 border-b border-white/[.06]">
      <a href={`${import.meta.env.BASE_URL}`} class="brand-gradient-text text-[22px] font-black no-underline">RHYTHMIX</a>
      <div>
        <a href={`${import.meta.env.BASE_URL}`} class="text-[#a0a0b0] no-underline text-sm font-semibold ml-4">Home</a>
        <a href={`${import.meta.env.BASE_URL}studio`} class="text-[#a0a0b0] no-underline text-sm font-semibold ml-4">Studio</a>
      </div>
    </nav>

    <main class="max-w-[760px] mx-auto px-6 py-12">
      <h1 class="font-black tracking-[-1px] mb-2" style="font-size:clamp(32px,6vw,48px);">{title}</h1>
      <p class="text-[#555] text-[13px] mb-8">Last updated: {updated}</p>

      <div class={`rounded-2xl px-6 py-5 mb-10 border ${summaryClasses}`}>
        <h2 class={`text-[13px] font-black tracking-[3px] uppercase mb-3 ${summaryHeading}`}>The Short Version</h2>
        <slot name="summary" />
      </div>

      <slot />
    </main>

    <footer class="text-center px-6 py-10 text-[#333] text-[13px] border-t border-white/[.05] mt-12">
      <slot name="footer" />
      <p class="mt-2.5">© 2026 RHYTHMIX</p>
    </footer>
  </body>
</html>

<style is:global>
  main h2 { font-size: 22px; font-weight: 900; margin: 32px 0 12px; color: #fff; }
  main h3 { font-size: 17px; font-weight: 800; margin: 20px 0 8px; color: #fff; }
  main p, main li { color: #a0a0b0; font-size: 15px; }
  main ul, main ol { padding-left: 24px; margin-bottom: 16px; }
  main li { padding: 4px 0; }
  main a { color: #00d8ff; }
</style>
