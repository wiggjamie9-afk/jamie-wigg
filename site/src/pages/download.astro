---
import "../styles/global.css";
const baseRaw = "https://github.com/wiggjamie9-afk/jamie-wigg/raw/claude/add-code-guidance-FbvgK";
const videos = [
  { title: "Vertical · 9:16",   dim: "1080×1920 · 32s", platforms: "TikTok · Instagram Reels · YouTube Shorts · FB Stories", file: "rhythmix-vertical/rhythmix-vertical.mp4" },
  { title: "Square · 1:1",      dim: "1080×1080 · 32s", platforms: "Instagram Feed · Facebook Feed", file: "rhythmix-square/rhythmix-square.mp4" },
  { title: "Landscape · 16:9",  dim: "1920×1080 · 32s", platforms: "YouTube", file: "rhythmix-32s/rhythmix-32s.mp4" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>RHYTHMIX — Download promo videos</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body class="px-5 pt-8 pb-15 min-h-screen" style="background:radial-gradient(700px 500px at 20% 0%, rgba(124,58,237,.25), transparent 60%),radial-gradient(700px 500px at 80% 100%, rgba(255,31,90,.20), transparent 60%),#08050d;">
    <div class="max-w-[540px] mx-auto">
      <div class="font-extrabold text-[44px] tracking-[-1.5px] mb-1.5" style="background:linear-gradient(135deg,#ff7aa6,#e0c0ff 50%,#8af6ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">RHYTHMIX</div>
      <div class="text-[#b9b3c6] text-base leading-snug mb-8">Three promo videos, ready to save to your phone. Tap ▶ to watch, then <b class="text-white">Save</b> to send to Photos.</div>

      {videos.map(v => (
        <div class="bg-[#1a1325] border border-white/[.12] rounded-[22px] px-5 pt-5 pb-4 mb-[18px]">
          <video controls playsinline preload="metadata" class="w-full rounded-[14px] bg-black block mb-4" src={`${baseRaw}/${v.file}`}></video>
          <div class="flex items-baseline justify-between mb-1">
            <div class="font-bold text-[19px] tracking-[-.3px]">{v.title}</div>
            <div class="font-mono text-xs text-[#b9b3c6] tracking-[1px] uppercase">{v.dim}</div>
          </div>
          <div class="text-[#b9b3c6] text-sm leading-snug my-1 mb-4">{v.platforms}</div>
          <div class="flex gap-2.5">
            <a class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl font-semibold text-[15px] no-underline border border-transparent text-white" style="background:linear-gradient(135deg,#ff1f5a,#7c3aed);" href={`${baseRaw}/${v.file}`} download={v.file.split("/").pop()}>⬇︎ Save</a>
            <a class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl font-semibold text-[15px] no-underline border border-white/[.12] text-white bg-white/[.04]" href={`${baseRaw}/${v.file}`}>▶︎ Open</a>
          </div>
        </div>
      ))}

      <div class="mt-7 px-5 py-[18px] bg-white/[.03] border border-white/[.12] rounded-[16px] text-[#b9b3c6] text-sm leading-snug">
        <b class="text-white">To save to Photos on iPhone:</b>
        <ol class="pl-[18px] mt-2 mb-0">
          <li class="my-1">Tap <b class="text-white">▶︎ Open</b> — the video plays full-screen.</li>
          <li class="my-1">Tap the <b class="text-white">share</b> icon (square with arrow up).</li>
          <li class="my-1">Choose <b class="text-white">Save Video</b>. It lands in your Photos.</li>
        </ol>
        <b class="text-white">To save to Files instead:</b> long-press <b class="text-white">⬇︎ Save</b> → <b class="text-white">Download Linked File</b>.
      </div>
    </div>
  </body>
</html>
