---
import Base from "../layouts/Base.astro";

interface Row {
  label: string;
  rhythmix: string;
  suno: string;
  udio: string;
  landr: string;
  acestep: string;
  highlight?: boolean;
}

const rows: Row[] = [
  { label: "Price",                        rhythmix: "$149 once",                suno: "$10–30/mo",        udio: "$10–30/mo",        landr: "$15–25/mo",       acestep: "Free",                     highlight: true },
  { label: "AI music generation",          rhythmix: "✓ Unlimited",              suno: "✓ Limited credits", udio: "✓ Limited credits", landr: "✗",               acestep: "✓ Unlimited" },
  { label: "AI mastering included",        rhythmix: "✓",                        suno: "✗",                 udio: "✗",                 landr: "✓",               acestep: "✗" },
  { label: "One-tap distribution",         rhythmix: "✓ 120+ platforms",         suno: "✗ (export only)",  udio: "✗ (export only)",  landr: "✓ DistroKid",     acestep: "✗ (export only)" },
  { label: "Royalty share",                rhythmix: "100% yours",               suno: "Pro plan only",     udio: "Pro plan only",     landr: "100% yours",      acestep: "100% yours" },
  { label: "Hardware required",            rhythmix: "Phone or laptop",           suno: "Phone or laptop",   udio: "Phone or laptop",   landr: "Phone or laptop", acestep: "NVIDIA GPU 4GB+",          highlight: true },
  { label: "Setup time",                   rhythmix: "30 seconds",                suno: "30 seconds",        udio: "30 seconds",        landr: "30 seconds",      acestep: "1–3 hours",                highlight: true },
  { label: "Works offline",                rhythmix: "—",                         suno: "✗",                 udio: "✗",                 landr: "✗",               acestep: "✓ (after setup)" },
  { label: "3D venue performances",        rhythmix: "✓ Coming",                  suno: "✗",                 udio: "✗",                 landr: "✗",               acestep: "✗" },
  { label: "Sync licensing marketplace",   rhythmix: "✓ Coming",                  suno: "✗",                 udio: "✗",                 landr: "✗",               acestep: "✗" },
  { label: "Cloud library",                rhythmix: "✓ Coming",                  suno: "✓",                 udio: "✓",                 landr: "✓",               acestep: "Local only" },
  { label: "Subscription locks you in",    rhythmix: "✗ Pay once",                suno: "✓",                 udio: "✓",                 landr: "✓",               acestep: "—" },
  { label: "Open source",                  rhythmix: "✗",                         suno: "✗",                 udio: "✗",                 landr: "✗",               acestep: "✓" },
];

const buyUrl = "https://wiggjamie.gumroad.com/l/rhythmix-studio";
---
<Base
  title="RHYTHMIX vs Suno, Udio, LANDR & ACE-Step — Honest Comparison"
  description="How RHYTHMIX compares to Suno, Udio, LANDR, and the free open-source ACE-Step UI. Honest take: what each does best, where they fall short, and when each one is the right choice."
  url="https://rhythmixapp.com.au/compare"
>
  <section class="text-center px-6 pt-16 pb-12" style="background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(124,58,237,.18),transparent);">
    <div class="inline-block bg-[rgba(245,192,0,.12)] border border-[rgba(245,192,0,.3)] text-[#f5c000] text-xs font-bold tracking-[3px] uppercase px-5 py-2 rounded-full mb-6">
      Honest Comparison · No Cherry-Picking
    </div>
    <h1 class="font-black leading-[1.05] tracking-[-1.5px] mb-5" style="font-size:clamp(36px,8vw,68px);">
      RHYTHMIX vs <em class="brand-gradient-text not-italic">everyone else.</em>
    </h1>
    <p class="text-[#a0a0b0] leading-relaxed max-w-[640px] mx-auto" style="font-size:clamp(15px,2.5vw,18px);">
      Suno, Udio, LANDR, the free open-source ACE-Step UI — they all have a place. Here's the honest table, including <strong class="text-white">when one of them beats us</strong>. Then decide.
    </p>
  </section>

  <section class="px-6 pb-16 max-w-[1100px] mx-auto">
    <div class="bg-[#0d0d0d] border border-white/[.08] rounded-[20px] overflow-x-auto">
      <table class="w-full border-collapse min-w-[760px]">
        <thead>
          <tr>
            <th class="text-left text-[11px] font-bold tracking-[2px] uppercase text-[#555] px-4 py-4 border-b border-white/[.08]">Feature</th>
            <th class="text-center text-xs font-extrabold uppercase px-4 py-4 border-b border-white/[.08] border-l border-l-white/[.08]">
              <span class="brand-gradient-text">RHYTHMIX</span>
            </th>
            <th class="text-center text-[13px] font-bold text-[#a0a0b0] px-4 py-4 border-b border-white/[.08] border-l border-l-white/[.04]">Suno</th>
            <th class="text-center text-[13px] font-bold text-[#a0a0b0] px-4 py-4 border-b border-white/[.08] border-l border-l-white/[.04]">Udio</th>
            <th class="text-center text-[13px] font-bold text-[#a0a0b0] px-4 py-4 border-b border-white/[.08] border-l border-l-white/[.04]">LANDR</th>
            <th class="text-center text-[13px] font-bold text-[#a0a0b0] px-4 py-4 border-b border-white/[.08] border-l border-l-white/[.04]">ACE-Step UI<br /><span class="text-[10px] font-normal text-[#555]">(open source)</span></th>
          </tr>
        </thead>
        <tbody>
          {rows.map(row => (
            <tr class={row.highlight ? "bg-[rgba(245,192,0,.04)]" : ""}>
              <td class="px-4 py-3.5 text-[13px] font-semibold text-white border-b border-white/[.04]">{row.label}</td>
              <td class={`px-4 py-3.5 text-[13px] text-center border-b border-white/[.04] border-l border-l-white/[.08] ${row.highlight ? "text-[#f5c000] font-extrabold" : "text-white font-semibold"}`}>{row.rhythmix}</td>
              <td class="px-4 py-3.5 text-[13px] text-center text-[#a0a0b0] border-b border-white/[.04] border-l border-l-white/[.04]">{row.suno}</td>
              <td class="px-4 py-3.5 text-[13px] text-center text-[#a0a0b0] border-b border-white/[.04] border-l border-l-white/[.04]">{row.udio}</td>
              <td class="px-4 py-3.5 text-[13px] text-center text-[#a0a0b0] border-b border-white/[.04] border-l border-l-white/[.04]">{row.landr}</td>
              <td class="px-4 py-3.5 text-[13px] text-center text-[#a0a0b0] border-b border-white/[.04] border-l border-l-white/[.04]">{row.acestep}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-[#555] text-xs text-center mt-3">Last updated May 2026. Prices and feature sets change — verify before purchase.</p>
  </section>

  <section class="px-6 pb-16 max-w-[900px] mx-auto">
    <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3 text-center">Where each one wins</div>
    <h2 class="font-black leading-[1.1] mb-12 text-center" style="font-size:clamp(28px,5vw,40px);">When NOT to choose RHYTHMIX</h2>

    <div class="grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));">
      <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d]">
        <div class="text-[28px] mb-3.5">🛠️</div>
        <h3 class="text-xl font-extrabold mb-2">Choose ACE-Step UI if…</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed mb-3">You already own a 12GB+ NVIDIA GPU, you're comfortable in a terminal, and you want to tinker with the model itself. Free forever, fully open.</p>
        <p class="text-[#555] text-xs">Trade-off: you handle the setup, the GPU bill, and there's no distribution / mastering / venues built in.</p>
      </div>

      <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d]">
        <div class="text-[28px] mb-3.5">🎼</div>
        <h3 class="text-xl font-extrabold mb-2">Choose Suno or Udio if…</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed mb-3">You make ≤10 tracks a year and don't care about distribution. The monthly fee will cost you less than $149 over a year of light use.</p>
        <p class="text-[#555] text-xs">Trade-off: subscription forever, generation credits run out, no Spotify pipeline.</p>
      </div>

      <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d]">
        <div class="text-[28px] mb-3.5">🎚️</div>
        <h3 class="text-xl font-extrabold mb-2">Choose LANDR if…</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed mb-3">You already record your own music and only need mastering + distribution. LANDR is the gold standard for those two things specifically.</p>
        <p class="text-[#555] text-xs">Trade-off: doesn't generate music. Pair it with one of the others.</p>
      </div>
    </div>
  </section>

  <section class="px-6 pb-16 max-w-[900px] mx-auto">
    <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3 text-center">Where we win</div>
    <h2 class="font-black leading-[1.1] mb-12 text-center" style="font-size:clamp(28px,5vw,40px);">Where RHYTHMIX is the right call</h2>

    <div class="flex flex-col gap-3.5">
      <div class="rounded-[20px] px-6 py-6 border border-[rgba(245,192,0,.25)]" style="background:linear-gradient(135deg,rgba(245,192,0,.08),rgba(245,192,0,.02));">
        <div class="flex items-start gap-4">
          <div class="text-[28px] flex-none">📱</div>
          <div>
            <h3 class="text-xl font-extrabold mb-1.5">No GPU. No terminal. No Python.</h3>
            <p class="text-[#a0a0b0] text-sm leading-relaxed">ACE-Step UI is incredible if you have an NVIDIA card and a free afternoon. RHYTHMIX runs from your phone. The whole platform — generate, master, distribute — fits in your pocket. That's the real difference.</p>
          </div>
        </div>
      </div>

      <div class="rounded-[20px] px-6 py-6 border border-[rgba(0,232,135,.25)]" style="background:linear-gradient(135deg,rgba(0,232,135,.08),rgba(0,232,135,.02));">
        <div class="flex items-start gap-4">
          <div class="text-[28px] flex-none">🌍</div>
          <div>
            <h3 class="text-xl font-extrabold mb-1.5">Generation isn't enough. You need to ship.</h3>
            <p class="text-[#a0a0b0] text-sm leading-relaxed">Every other tool stops at "here's an MP3, good luck." RHYTHMIX masters it, pushes it to Spotify, Apple Music, TikTok, YouTube Music, and 120+ more, and routes 100% of your royalties straight to you. One workflow. Done.</p>
        </div>
      </div>
      </div>

      <div class="rounded-[20px] px-6 py-6 border border-[rgba(124,58,237,.3)]" style="background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(124,58,237,.02));">
        <div class="flex items-start gap-4">
          <div class="text-[28px] flex-none">💰</div>
          <div>
            <h3 class="text-xl font-extrabold mb-1.5">$149 once. Math wins after month 5.</h3>
            <p class="text-[#a0a0b0] text-sm leading-relaxed">Suno + LANDR + DistroKid is roughly $58/month bundled. RHYTHMIX pays for itself before half a year. After that, every month is free for you and pure subscription burn for them.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 pb-20 max-w-[700px] mx-auto">
    <div class="border border-[rgba(124,58,237,.3)] rounded-3xl px-7 py-12 text-center" style="background:linear-gradient(135deg,#0d0020,#000);">
      <h2 class="font-black mb-3" style="font-size:clamp(28px,6vw,42px);">Still on the fence?</h2>
      <p class="text-[#a0a0b0] text-base mb-7 max-w-[480px] mx-auto leading-relaxed">30-day money-back guarantee. Reply to your receipt, get a full refund within 24 hours. No questions, no friction.</p>
      <a href={buyUrl} class="gold-gradient text-black text-xl font-black px-10 py-[22px] rounded-2xl no-underline inline-block" style="box-shadow:0 0 30px rgba(245,192,0,.25);">Try RHYTHMIX — $149 →</a>
      <p class="text-[#555] text-[13px] mt-5">One time · All future features included · No subscription, ever</p>
    </div>
  </section>
</Base>
