---
import "../styles/global.css";

const liveFeatures = [
  { color: "gold",    icon: "🎵", h: "AI Music Generation",   p: "Type a vibe, a genre, a feeling — get a full professional track in under 30 seconds. 22 tools. Any style." },
  { color: "cyan",    icon: "🎛️", h: "AI Mastering",           p: "Every track is automatically mastered to streaming standards. Sounds like it cost $500 to produce. Costs you nothing extra." },
  { color: "magenta", icon: "🌍", h: "One-Tap Distribution",   p: "Publish straight to Spotify, Apple Music, TikTok, YouTube Music, and 120+ platforms in one tap." },
  { color: "green",   icon: "💰", h: "100% Royalties",         p: "Every cent your music earns goes directly to you. No label cut. No platform cut. Yours forever." },
];
const featCardBg = {
  gold: "border-[rgba(245,192,0,.25)] bg-[#0d0b00]",
  cyan: "border-[rgba(0,216,255,.2)] bg-[#000d10]",
  magenta: "border-[rgba(255,31,90,.2)] bg-[#0d0008]",
  green: "border-[rgba(0,232,135,.2)] bg-[#000d05]",
} as const;
const tracks = [
  { n: 1, title: "Midnight Drive", time: "3:42 · Created today",  genre: "Pop",  genreClass: "bg-[rgba(255,31,90,.15)] text-[#ff1f5a]", plays: "1.2k plays", art: "linear-gradient(135deg,#ff1f5a,#7c3aed)" },
  { n: 2, title: "Arena Anthem",   time: "4:15 · Yesterday",      genre: "Rock", genreClass: "bg-[rgba(245,192,0,.15)] text-[#f5c000]", plays: "847 plays",  art: "linear-gradient(135deg,#f5c000,#ff6600)" },
  { n: 3, title: "Blue Hour",      time: "5:02 · 3 days ago",     genre: "Jazz", genreClass: "bg-[rgba(0,216,255,.12)] text-[#00d8ff]", plays: "312 plays",  art: "linear-gradient(135deg,#00d8ff,#00e887)" },
  { n: 4, title: "Bass Protocol",  time: "6:18 · Last week",      genre: "Rave", genreClass: "bg-[rgba(124,58,237,.2)] text-[#a78bfa]", plays: "2.9k plays", art: "linear-gradient(135deg,#7c3aed,#ff1f5a)" },
];
const savings = [
  { tool: "Suno AI (music generation)", month: "$10/mo",     year: "$120/yr" },
  { tool: "LANDR (AI mastering)",        month: "~$29/track", year: "$350/yr" },
  { tool: "DistroKid (distribution)",    month: "$2/mo",      year: "$24/yr" },
  { tool: "Splice (tools + samples)",    month: "$17/mo",     year: "$204/yr" },
];
const testimonials = [
  { text: '"I typed \'melancholy late night R&B\' and had a full mastered track in under a minute. I\'ve been paying $200/month across three different tools for years. This is insane value."', name: "Marcus T.",  role: "Independent Artist · Sydney",            avatar: "linear-gradient(135deg,#ff1f5a,#7c3aed)" },
  { text: '"I make content for YouTube and always struggled to find royalty-free music that didn\'t sound like elevator music. Now I generate custom tracks in 30 seconds that actually fit my videos perfectly."', name: "Sarah K.",   role: "Content Creator · 180K subscribers",   avatar: "linear-gradient(135deg,#7c3aed,#00d8ff)" },
  { text: '"The 100% royalties thing is what got me. Every other platform takes a cut. I published 12 tracks last month and every cent went straight to me. $149 paid for itself in week one."', name: "DJ Reeves", role: "Electronic Producer · Melbourne",        avatar: "linear-gradient(135deg,#f5c000,#ff6600)" },
];
const priceList = [
  "AI music generation — unlimited",
  "AI mastering on every track",
  "Distribution to 120+ platforms",
  "100% of your royalties — always",
  "Cloud music library storage",
  "3D venue performances (when released)",
  "Sync licensing marketplace (when released)",
  "All future features included — forever",
];
const buyHref = "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RHYTHMIX — Your First Track Ready in 47 Seconds · $149 Lifetime Deal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav class="flex justify-between items-center px-6 py-5 border-b border-white/[.08]">
      <span class="brand-gradient-text text-[22px] font-black">RHYTHMIX</span>
      <div class="flex gap-5 items-center">
        <a href="/features" class="text-[#a0a0b0] no-underline text-sm font-semibold hover:text-white">Features</a>
        <a href="/downloads" class="text-[#a0a0b0] no-underline text-sm font-semibold hover:text-white">Downloads</a>
        <a class="purple-gradient text-white px-5 py-2.5 rounded-full text-sm font-bold no-underline" href="/">Get Early Access →</a>
      </div>
    </nav>

    <div class="text-center px-6 pt-20 pb-15">
      <div class="inline-block bg-[rgba(245,192,0,.12)] border border-[rgba(245,192,0,.3)] text-[#f5c000] text-xs font-bold tracking-[3px] uppercase px-5 py-2 rounded-full mb-6">The World's First Complete AI Music Platform</div>
      <h1 class="font-black leading-[1.05] mb-5" style="font-size:clamp(36px,8vw,72px);">Your first track,<br /><span class="brand-gradient-text">ready in 47 seconds.</span></h1>
      <p class="text-[#a0a0b0] text-lg max-w-[540px] mx-auto mb-9 leading-relaxed">Generate professional tracks, master them instantly, perform in any venue, store your library, and distribute to Spotify — all for one price, forever.</p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a class="purple-gradient text-white text-[17px] font-extrabold px-8 py-[18px] rounded-[14px] no-underline" href={buyHref}>Get Early Access — $149</a>
        <a class="bg-white/[.08] border border-white/[.15] text-white text-[17px] font-bold px-8 py-[18px] rounded-[14px] no-underline" href="/downloads">Watch the Videos</a>
      </div>
    </div>

    <hr class="border-none border-t border-white/[.06]" />

    <section class="px-6 py-20 max-w-[900px] mx-auto">
      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3">Live Now</div>
      <h2 class="font-black leading-[1.1] mb-4" style="font-size:clamp(28px,5vw,48px);">Everything you need<br />to make music tonight</h2>
      <p class="text-[#a0a0b0] text-base leading-relaxed max-w-[600px] mb-12">These features are live in RHYTHMIX right now. No experience needed. No studio. No label.</p>
      <div class="grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));">
        {liveFeatures.map(f => (
          <div class={`rounded-[20px] px-6 py-7 border ${featCardBg[f.color]}`}>
            <div class="inline-block bg-[rgba(0,232,135,.15)] border border-[rgba(0,232,135,.3)] text-[#00e887] text-[10px] font-bold tracking-[2px] uppercase px-2.5 py-1 rounded-full mb-3">Live</div>
            <div class="text-[32px] mb-3.5">{f.icon}</div>
            <h3 class="text-xl font-extrabold mb-2">{f.h}</h3>
            <p class="text-[#a0a0b0] text-sm leading-relaxed">{f.p}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-none border-t border-white/[.06]" />

    <section class="px-6 py-20 max-w-[900px] mx-auto">
      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3">Coming Next</div>
      <h2 class="font-black leading-[1.1] mb-4" style="font-size:clamp(28px,5vw,48px);">3D Performance Venues</h2>
      <p class="text-[#a0a0b0] text-base leading-relaxed max-w-[600px] mb-12">Your music deserves a stage. Choose your venue — from underground rave to sold-out arena — and watch your track come alive in a fully animated 3D environment.</p>
      <div class="grid grid-cols-2 gap-3 mb-8">
        <div class="rounded-[20px] aspect-[9/14] relative overflow-hidden flex items-end px-4 py-5 border border-[rgba(255,31,90,.2)]" style="background:linear-gradient(180deg,#000 0%,#1a0020 40%,#000 100%);">
          <div class="absolute top-1/5 left-1/2 -translate-x-1/2 w-20 h-20 rounded-full bg-white/90 opacity-70" style="box-shadow:0 0 60px 40px rgba(255,100,200,.3),0 0 30px 15px rgba(100,100,255,.4);"></div>
          <div class="relative z-[2]"><span class="text-[10px] font-bold tracking-[3px] uppercase text-[#a0a0b0] block mb-1">Venue 01</span><strong class="text-[15px] font-extrabold text-white">Disco Club</strong></div>
        </div>
        <div class="rounded-[20px] aspect-[9/14] relative overflow-hidden flex items-end px-4 py-5 border border-[rgba(245,192,0,.2)]" style="background:linear-gradient(180deg,#000 0%,#120500 50%,#000 100%);">
          <div class="absolute top-[10%] left-1/2 -translate-x-1/2 w-1 h-[200px]" style="background:linear-gradient(180deg,rgba(255,200,50,.8),transparent);box-shadow:0 0 30px 20px rgba(255,150,0,.3);"></div>
          <div class="relative z-[2]"><span class="text-[10px] font-bold tracking-[3px] uppercase text-[#a0a0b0] block mb-1">Venue 02</span><strong class="text-[15px] font-extrabold text-white">Rock Arena</strong></div>
        </div>
        <div class="rounded-[20px] aspect-[9/14] relative overflow-hidden flex items-end px-4 py-5 border border-[rgba(245,192,0,.15)]" style="background:linear-gradient(180deg,#000 0%,#1a0800 50%,#000 100%);">
          <div class="absolute top-[15%] left-1/2 -translate-x-1/2 w-[120px] h-[200px]" style="background:radial-gradient(ellipse,rgba(255,200,80,.25) 0%,transparent 70%);"></div>
          <div class="relative z-[2]"><span class="text-[10px] font-bold tracking-[3px] uppercase text-[#a0a0b0] block mb-1">Venue 03</span><strong class="text-[15px] font-extrabold text-white">Jazz Lounge</strong></div>
        </div>
        <div class="rounded-[20px] aspect-[9/14] relative overflow-hidden flex items-end px-4 py-5 border border-[rgba(124,58,237,.3)]" style="background:linear-gradient(180deg,#000 0%,#0d0020 50%,#000 100%);">
          <div class="absolute top-[30%] left-1/2 -translate-x-1/2 w-[200px] h-[2px] bg-[rgba(124,58,237,.6)]" style="box-shadow:0 0 20px 8px rgba(124,58,237,.3);"></div>
          <div class="relative z-[2]"><span class="text-[10px] font-bold tracking-[3px] uppercase text-[#a0a0b0] block mb-1">Venue 04</span><strong class="text-[15px] font-extrabold text-white">Underground Rave</strong></div>
        </div>
      </div>
      <div class="rounded-[20px] px-6 py-7 border border-[rgba(124,58,237,.25)] bg-[#07001a]">
        <div class="inline-block bg-[rgba(124,58,237,.15)] border border-[rgba(124,58,237,.3)] text-[#a78bfa] text-[10px] font-bold tracking-[2px] uppercase px-2.5 py-1 rounded-full mb-3">In Development</div>
        <div class="text-[32px] mb-3.5">🎭</div>
        <h3 class="text-xl font-extrabold mb-2">How It Works</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">Generate your track → select a venue → RHYTHMIX renders your music inside the 3D stage with real-time lighting, crowd reactions, and atmosphere that reacts to your beat. Export as video. Post anywhere.</p>
      </div>
    </section>

    <hr class="border-none border-t border-white/[.06]" />

    <section class="px-6 py-20 max-w-[900px] mx-auto">
      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3">Coming Next</div>
      <h2 class="font-black leading-[1.1] mb-4" style="font-size:clamp(28px,5vw,48px);">Your Music Library</h2>
      <p class="text-[#a0a0b0] text-base leading-relaxed max-w-[600px] mb-12">Every track you create is saved, organised, and accessible forever. Stream, download, share, or re-master any track at any time.</p>

      <div class="bg-[#0d0d0d] border border-white/[.08] rounded-[20px] overflow-hidden mb-8">
        <div class="flex justify-between items-center px-6 py-5 border-b border-white/[.06]">
          <h3 class="text-lg font-extrabold">My Library</h3>
          <span class="text-[#a0a0b0] text-[13px]">47 tracks · 2.3 GB</span>
        </div>
        {tracks.map(t => (
          <div class="flex items-center gap-3.5 px-6 py-3.5 border-b border-white/[.04] last:border-b-0">
            <span class="text-[#555] text-xs w-4 text-center">{t.n}</span>
            <div class="w-10 h-10 rounded-lg flex-shrink-0" style={`background:${t.art}`}></div>
            <div class="flex-1 min-w-0">
              <strong class="block text-sm font-bold whitespace-nowrap overflow-hidden text-ellipsis">{t.title}</strong>
              <span class="text-xs text-[#a0a0b0]">{t.time}</span>
            </div>
            <span class={`text-[11px] font-semibold tracking-[1px] uppercase px-2 py-0.5 rounded-full flex-shrink-0 ${t.genreClass}`}>{t.genre}</span>
            <span class="text-xs text-[#555] flex-shrink-0">{t.plays}</span>
            <span class="text-[#555] text-lg flex-shrink-0 px-1">···</span>
          </div>
        ))}
        <div class="px-6 py-4 flex gap-2.5">
          <button class="flex-1 text-center py-3 rounded-[10px] text-[13px] font-bold bg-white/[.08] text-white border border-white/[.12]">⬆ Upload Track</button>
          <button class="flex-1 text-center py-3 rounded-[10px] text-[13px] font-bold purple-gradient text-white">+ Generate New</button>
        </div>
      </div>

      <div class="grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));">
        <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d]">
          <div class="inline-block bg-[rgba(124,58,237,.15)] border border-[rgba(124,58,237,.3)] text-[#a78bfa] text-[10px] font-bold tracking-[2px] uppercase px-2.5 py-1 rounded-full mb-3">In Development</div>
          <div class="text-[32px] mb-3.5">☁️</div>
          <h3 class="text-xl font-extrabold mb-2">Cloud Storage</h3>
          <p class="text-[#a0a0b0] text-sm leading-relaxed">All your tracks, stems, and project files stored securely in the cloud. Access from any device, anytime.</p>
        </div>
        <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d]">
          <div class="inline-block bg-[rgba(124,58,237,.15)] border border-[rgba(124,58,237,.3)] text-[#a78bfa] text-[10px] font-bold tracking-[2px] uppercase px-2.5 py-1 rounded-full mb-3">In Development</div>
          <div class="text-[32px] mb-3.5">📁</div>
          <h3 class="text-xl font-extrabold mb-2">Smart Organisation</h3>
          <p class="text-[#a0a0b0] text-sm leading-relaxed">Auto-tagged by genre, mood, BPM, and date. Search your entire library in seconds. Build playlists and albums.</p>
        </div>
      </div>
    </section>

    <hr class="border-none border-t border-white/[.06]" />

    <section class="px-6 py-20 max-w-[900px] mx-auto">
      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3">Coming Next · Biggest Opportunity</div>
      <h2 class="font-black leading-[1.1] mb-4" style="font-size:clamp(28px,5vw,48px);">Sync Licensing Marketplace</h2>
      <p class="text-[#a0a0b0] text-base leading-relaxed max-w-[600px] mb-12">TV shows, films, video games, and ads need music constantly. RHYTHMIX connects your tracks directly to music supervisors looking to buy. One placement can pay more than 1 million Spotify streams.</p>
      <div class="border border-[rgba(245,192,0,.25)] rounded-[20px] px-7 py-8" style="background:linear-gradient(135deg,rgba(245,192,0,.08),rgba(245,192,0,.02));">
        <div class="text-5xl font-black text-[#f5c000] mb-1">$1,200+</div>
        <div class="text-[#a0a0b0] text-sm mb-5">Average sync licensing deal · you keep 80%</div>
        <div class="flex flex-col gap-2.5">
          <div class="flex justify-between items-center bg-black/30 rounded-[10px] px-4 py-3"><span class="text-[#a0a0b0] text-[13px]">🎬 TV Commercial placement</span><strong class="text-sm text-[#f5c000] font-extrabold">$500 – $5,000</strong></div>
          <div class="flex justify-between items-center bg-black/30 rounded-[10px] px-4 py-3"><span class="text-[#a0a0b0] text-[13px]">🎮 Video game track license</span><strong class="text-sm text-[#f5c000] font-extrabold">$2,000 – $15,000</strong></div>
          <div class="flex justify-between items-center bg-black/30 rounded-[10px] px-4 py-3"><span class="text-[#a0a0b0] text-[13px]">🎥 Film background score</span><strong class="text-sm text-[#f5c000] font-extrabold">$1,000 – $8,000</strong></div>
          <div class="flex justify-between items-center bg-black/30 rounded-[10px] px-4 py-3"><span class="text-[#a0a0b0] text-[13px]">📺 Streaming series theme</span><strong class="text-sm text-[#f5c000] font-extrabold">$3,000 – $25,000</strong></div>
        </div>
      </div>
    </section>

    <hr class="border-none border-t border-white/[.06]" />

    <section class="px-6 py-20 max-w-[900px] mx-auto">
      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3">Early Access Closes In</div>
      <div class="border border-[rgba(255,31,90,.3)] rounded-[20px] px-6 py-7 text-center mb-5" style="background:linear-gradient(135deg,#1a0008,#000);">
        <div class="text-xs font-bold tracking-[3px] uppercase text-[#ff1f5a] mb-3">⚡ Launch price expires</div>
        <div class="flex justify-center gap-3 flex-wrap">
          <div class="bg-black/50 border border-[rgba(255,31,90,.2)] rounded-xl px-4 py-3 min-w-[64px]"><span class="block text-4xl font-black text-[#ff1f5a] leading-none tabular-nums" id="cd-h">47</span><span class="block text-[10px] font-bold tracking-[2px] uppercase text-[#555] mt-1">Hours</span></div>
          <div class="bg-black/50 border border-[rgba(255,31,90,.2)] rounded-xl px-4 py-3 min-w-[64px]"><span class="block text-4xl font-black text-[#ff1f5a] leading-none tabular-nums" id="cd-m">59</span><span class="block text-[10px] font-bold tracking-[2px] uppercase text-[#555] mt-1">Minutes</span></div>
          <div class="bg-black/50 border border-[rgba(255,31,90,.2)] rounded-xl px-4 py-3 min-w-[64px]"><span class="block text-4xl font-black text-[#ff1f5a] leading-none tabular-nums" id="cd-s">59</span><span class="block text-[10px] font-bold tracking-[2px] uppercase text-[#555] mt-1">Seconds</span></div>
        </div>
        <p class="text-sm text-[#a0a0b0] mt-3.5">After this, the $149 lifetime deal is gone. <strong class="text-white">Price goes to $39/month.</strong></p>
      </div>

      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3 mt-12">Replace Your Entire Stack</div>
      <h2 class="font-black leading-[1.1] mb-4" style="font-size:clamp(28px,5vw,48px);">$698/year vs $149 once</h2>
      <p class="text-[#a0a0b0] text-base leading-relaxed max-w-[600px] mb-12">You're already paying for these tools separately. RHYTHMIX replaces all of them.</p>
      <div class="rounded-[20px] border border-white/[.08] bg-[#0d0d0d] overflow-hidden mb-4">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="text-[11px] font-bold tracking-[2px] uppercase text-[#555] px-3 py-2.5 text-left border-b border-white/[.06]">Tool You're Replacing</th>
              <th class="text-[11px] font-bold tracking-[2px] uppercase text-[#555] px-3 py-2.5 text-right border-b border-white/[.06]">Per Month</th>
              <th class="text-[11px] font-bold tracking-[2px] uppercase text-[#555] px-3 py-2.5 text-right border-b border-white/[.06]">Per Year</th>
            </tr>
          </thead>
          <tbody>
            {savings.map(s => (
              <tr>
                <td class="px-3 py-3.5 text-sm border-b border-white/[.04] font-semibold text-white">{s.tool}</td>
                <td class="px-3 py-3.5 text-sm border-b border-white/[.04] text-right text-[#a0a0b0]">{s.month}</td>
                <td class="px-3 py-3.5 text-sm border-b border-white/[.04] text-right text-[#ff1f5a] font-bold">{s.year}</td>
              </tr>
            ))}
            <tr>
              <td class="px-3 py-3.5 text-sm border-t border-white/[.1] font-extrabold text-[#ff1f5a]">Total stack cost</td>
              <td class="px-3 py-3.5 text-sm border-t border-white/[.1] text-right font-extrabold" style="color:#ff1f5a">$58+/mo</td>
              <td class="px-3 py-3.5 text-[18px] border-t border-white/[.1] text-right text-[#ff1f5a] font-extrabold">$698/yr</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="border border-[rgba(0,232,135,.25)] rounded-[14px] px-4 py-5 flex justify-between items-center flex-wrap gap-3" style="background:linear-gradient(135deg,rgba(0,232,135,.1),rgba(0,232,135,.03));">
        <div>
          <p class="text-[15px] text-[#a0a0b0]">You save every year with RHYTHMIX</p>
          <p class="text-xl text-[#00e887] font-extrabold block">$549/yr saved — forever</p>
        </div>
        <div class="text-right">
          <span class="text-[11px] text-[#555] line-through block">Was $399/yr</span>
          <strong class="text-4xl text-[#f5c000] font-black leading-none">$149</strong>
          <em class="not-italic text-xs text-[#a0a0b0] block">One time · own it forever</em>
        </div>
      </div>

      <h2 class="font-black leading-[1.1] mt-14 mb-9" style="font-size:clamp(28px,5vw,48px);">What early users are saying</h2>
      <div class="flex flex-col gap-3.5 mb-8">
        {testimonials.map(t => (
          <div class="bg-[#0d0d0d] border border-white/[.07] rounded-[16px] px-5 py-5">
            <div class="text-[#f5c000] text-sm mb-2">★★★★★</div>
            <p class="text-[15px] leading-relaxed mb-3.5 text-[#e0e0e0] italic">{t.text}</p>
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full flex-shrink-0" style={`background:${t.avatar}`}></div>
              <div>
                <div class="text-[13px] font-bold">{t.name}</div>
                <div class="text-xs text-[#555]">{t.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-none border-t border-white/[.06]" />

    <section class="px-6 py-20 max-w-[900px] mx-auto">
      <div class="border border-[rgba(124,58,237,.3)] rounded-3xl px-7 py-10 text-center mb-12" style="background:linear-gradient(135deg,rgba(124,58,237,.15),rgba(0,216,255,.08));">
        <div class="text-lg text-[#555] line-through mb-2">$399 / year forever</div>
        <div class="text-[72px] font-black text-[#f5c000] leading-none mb-2">$149</div>
        <div class="text-[15px] text-[#a0a0b0] mb-7">One time. Own it forever.</div>
        <ul class="list-none mb-8 flex flex-col gap-2.5">
          {priceList.map(item => (
            <li class="text-[#a0a0b0] text-[15px]"><span class="text-[#00e887] mr-2">✓</span>{item}</li>
          ))}
        </ul>
        <a class="block text-center no-underline gold-gradient text-black text-xl font-black px-8 py-[22px] rounded-2xl mb-3" href={buyHref}>Get Lifetime Access — $149 →</a>
        <p class="text-[13px] text-[#555]">Limited early access spots · Price goes up after launch</p>
        <div class="mt-6 text-center">
          <button onclick="document.getElementById('code-row').style.display='flex'" class="bg-transparent border-none text-[#555] text-[13px] cursor-pointer underline p-0">Have a founder code?</button>
          <div id="code-row" class="hidden justify-center gap-2.5 mt-3 flex-wrap">
            <input id="founder-code" type="text" placeholder="Enter code" class="bg-white/[.08] border border-white/[.15] rounded-[10px] text-white text-[15px] px-4 py-3 outline-none w-[180px] text-center tracking-[2px]" />
            <button onclick="checkFounderCode()" class="gold-gradient text-black text-sm font-extrabold border-none rounded-[10px] px-5 py-3 cursor-pointer">Unlock</button>
          </div>
          <p id="code-error" class="hidden text-[#ff1f5a] text-[13px] mt-2">Invalid code. Try again.</p>
        </div>
      </div>

      <div class="bg-white/[.03] border border-white/[.07] rounded-[20px] px-6 py-8 text-center mb-12">
        <h3 class="text-xl font-extrabold mb-2">Not ready yet? Get notified.</h3>
        <p class="text-[#a0a0b0] text-sm mb-5">Drop your email and we'll send you the early access link when everything is ready.</p>
        <form action="https://formspree.io/f/mjglrdeo" method="POST">
          <div class="flex gap-2.5 max-w-[480px] mx-auto">
            <input type="email" name="email" placeholder="your@email.com" required class="flex-1 bg-white/[.08] border border-white/[.15] rounded-xl text-white text-base px-4 py-3.5 outline-none placeholder:text-[#555] focus:border-[#7c3aed]" />
            <button type="submit" class="purple-gradient text-white text-[15px] font-extrabold border-none rounded-xl px-5 py-3.5 cursor-pointer whitespace-nowrap">Notify Me</button>
          </div>
        </form>
      </div>
    </section>

    <footer class="text-center px-6 py-10 text-[#333] text-[13px]">
      <p class="mb-3">
        <a href="/" class="text-[#555] no-underline">rhythmixapp.com.au</a> ·
        <a href="/features" class="text-[#555] no-underline">Features</a> ·
        <a href="/downloads" class="text-[#555] no-underline">Download Videos</a>
      </p>
      <p>© 2026 RHYTHMIX · The World's First Complete AI Music Platform</p>
    </footer>

    <script is:inline>
      function checkFounderCode() {
        var code = document.getElementById('founder-code').value.trim().toUpperCase();
        if (code === 'JAMIE2026') {
          window.location.href = '/founder';
        } else {
          var err = document.getElementById('code-error');
          err.classList.remove('hidden');
          setTimeout(function() { err.classList.add('hidden'); }, 2500);
        }
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && document.getElementById('founder-code') === document.activeElement) {
          checkFounderCode();
        }
      });
      (function() {
        var key = 'rhythmix_deadline';
        var deadline = localStorage.getItem(key);
        if (!deadline) { deadline = Date.now() + 48 * 60 * 60 * 1000; localStorage.setItem(key, deadline); }
        deadline = parseInt(deadline);
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function tick() {
          var diff = Math.max(0, deadline - Date.now());
          var h = Math.floor(diff / 3600000);
          var m = Math.floor((diff % 3600000) / 60000);
          var s = Math.floor((diff % 60000) / 1000);
          var hEl = document.getElementById('cd-h'), mEl = document.getElementById('cd-m'), sEl = document.getElementById('cd-s');
          if (hEl) hEl.textContent = pad(h);
          if (mEl) mEl.textContent = pad(m);
          if (sEl) sEl.textContent = pad(s);
        }
        tick();
        setInterval(tick, 1000);
      })();
    </script>
  </body>
</html>
