---
import "../styles/global.css";

const baseRaw = "https://raw.githubusercontent.com/wiggjamie9-afk/jamie-wigg";

interface Vid {
  badge: string;
  variant: "p" | "l";
  title: string;
  desc: string;
  url: string;
  hint: string;
  cta?: string;
}

const latest: Vid[] = [
  { badge: "60s · Landscape · Platform Overview", variant: "l", title: "Video 17 — RHYTHMIX Overview (1 minute)", desc: '"What if making music didn\'t take years?" — full platform overview in five scenes: hook + reveal, four pillars (Generate · Master · Distribute · Earn), how-it-works, audience, and waitlist CTA. British female voiceover.', url: `${baseRaw}/787c1beca216cfe2b5ba15085c523422775e8e1d/rhythmix-overview-60s/rhythmix-overview-60s.mp4`, hint: "4.5 MB · 1920×1080 · iPhone-ready", cta: "⬇ Download Video 17" },
  { badge: "15s · Landscape · Paid Ad Short", variant: "l", title: "Video 18 — Hyper-Short Ad (15s)", desc: '"What if making music didn\'t take years? RHYTHMIX. A complete studio in your pocket. Generate. Master. Release. Earn." Three scenes: hook → 4-pillar flash → waitlist CTA. Built for paid ads. British female voiceover.', url: `${baseRaw}/f77780cf6219efe9bbfe31f3b5c1a71bebf7acf4/rhythmix-15s/rhythmix-15s.mp4`, hint: "1.5 MB · 1920×1080 · iPhone-ready", cta: "⬇ Download Video 18" },
  { badge: "30s · Portrait · TikTok / Reels / Shorts", variant: "p", title: "Video 19 — Stop Dreaming (30s Vertical)", desc: '"Stop dreaming about making music. RHYTHMIX puts a complete studio in your pocket." Four scenes: hook + reveal → Describe/Refine/Release → 4 pillars → CTA. 1080×1920 vertical for short-form social. British female voiceover.', url: `${baseRaw}/f77780cf6219efe9bbfe31f3b5c1a71bebf7acf4/rhythmix-tiktok-30s/rhythmix-tiktok-30s.mp4`, hint: "2.0 MB · 1080×1920 · iPhone-ready", cta: "⬇ Download Video 19" },
  { badge: "60s · Square · Instagram Feed / LinkedIn", variant: "l", title: "Video 20 — Overview (Square 1080×1080)", desc: 'The full RHYTHMIX overview adapted to a 1:1 square frame for Instagram feed and LinkedIn. Same 5-scene narrative as Video 17, recomposed for centre-stack viewing. British female voiceover.', url: `${baseRaw}/f77780cf6219efe9bbfe31f3b5c1a71bebf7acf4/rhythmix-square-60s/rhythmix-square-60s.mp4`, hint: "3.3 MB · 1080×1080 · iPhone-ready", cta: "⬇ Download Video 20" },
  { badge: "60s · Landscape · Founder Story", variant: "l", title: "Video 21 — Hi, I'm Jamie (Founder Cut)", desc: '"Hi, I\'m Jamie. A year ago I was making music on my iPhone with apps that fought me every step of the way." Personal founder narrative in four scenes: greeting + problems → "One developer. One iPhone." reveal → today\'s pillars → waitlist CTA. American male voiceover (Michael).', url: `${baseRaw}/f77780cf6219efe9bbfe31f3b5c1a71bebf7acf4/rhythmix-founder-60s/rhythmix-founder-60s.mp4`, hint: "3.7 MB · 1920×1080 · iPhone-ready", cta: "⬇ Download Video 21" },
];
const portrait30: Vid[] = [
  { badge: "30s · Portrait · 1080×1920", variant: "p", title: "Video 1 — World Announcement",       desc: '"The World\'s First AI Music Platform" — launch declaration, 4 pillars, 100% royalties', url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-announce-30s/renders/rhythmix-announce-30s_2026-05-07_05-16-10.mp4`, hint: "2.5 MB · Hollywood rebuild", cta: "⬇ Download Video 1" },
  { badge: "30s · Portrait · 1080×1920", variant: "p", title: "Video 2 — Who Is It For?",            desc: 'Bedroom producers, artists, creators, podcasters, filmmakers, songwriters — "RHYTHMIX is for YOU"', url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-who-30s/renders/rhythmix-who-30s_2026-05-07_05-17-01.mp4`, hint: "1.8 MB · Hollywood rebuild", cta: "⬇ Download Video 2" },
  { badge: "30s · Portrait · 1080×1920", variant: "p", title: "Video 3 — World First + $149 Deal",  desc: '22 tools vs 4 competitors · $149 lifetime deal · "Own your sound. Own your future."', url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-worldfirst-30s/renders/rhythmix-worldfirst-30s_2026-05-07_05-17-41.mp4`, hint: "1.6 MB · Hollywood rebuild", cta: "⬇ Download Video 3" },
];
const landscape60: Vid[] = [
  { badge: "60s · Landscape · 1920×1080", variant: "l", title: "Video 4 — Full Platform Debut",     desc: 'Complete overview — Generate, Master, Distribute, Earn + who it\'s for + CTA', url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-debut-60s/renders/rhythmix-debut-60s_2026-05-07_05-18-32.mp4`, hint: "1.4 MB · Hollywood rebuild", cta: "⬇ Download Video 4" },
  { badge: "60s · Landscape · 1920×1080", variant: "l", title: "Video 5 — Studio in Your Pocket",   desc: 'Creator story — type a vibe, track ready in 30s, live on Spotify before lunch', url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-creator-60s/renders/rhythmix-creator-60s_2026-05-07_05-19-46.mp4`, hint: "1.4 MB · Hollywood rebuild", cta: "⬇ Download Video 5" },
  { badge: "60s · Landscape · 1920×1080", variant: "l", title: "Video 6 — Musical Revolution",       desc: 'Authoritative declaration — 4 pillars, world-first proof, new era of music creation', url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-era-60s/renders/rhythmix-era-60s_2026-05-07_05-20-49.mp4`, hint: "1.3 MB · Hollywood rebuild", cta: "⬇ Download Video 6" },
];
const premiere: Vid[] = [
  { badge: "60s · Portrait · Founder Story",            variant: "p", title: "Video 13 — One Man. One iPhone.",        desc: '"No studio. No team. No label. Just one man and his iPhone." — personal founder story with iPhone silhouette, RHYTHMIX reveal, feature lightning round. Male voiceover.', url: `${baseRaw}/076d4a6/rhythmix-iphone-60s/renders/rhythmix-iphone-60s_2026-05-07_12-07-28.mp4`, hint: "3.9 MB", cta: "⬇ Download Video 13" },
  { badge: "60s · Landscape · World Premiere Origin",   variant: "l", title: "Video 14 — World Premiere: The Origin Story", desc: '"This is the story of RHYTHMIX." — cinematic documentary origin story. Jamie picks up an iPhone and builds the impossible. Grand theatrical reveal with gold lines and premiere title cards. Female voiceover.', url: `${baseRaw}/ef738d8/rhythmix-origin-60s/renders/rhythmix-origin-60s.mp4`, hint: "~3 MB", cta: "⬇ Download Video 14" },
  { badge: "60s · Portrait · Personal Backstory",       variant: "p", title: "Video 16 — The Backstory (Jamie's Story)", desc: '"Everyone said it couldn\'t be done. They were wrong." — typewriter cold open, iPhone silhouette name card, RHYTHMIX reveal, rapid-fire stat pops, gold CTA closer. Male voiceover. Most personal video in the set.', url: `${baseRaw}/513d988/rhythmix-backstory-60s/renders/rhythmix-backstory-60s.mp4`, hint: "5.8 MB", cta: "⬇ Download Video 16" },
  { badge: "60s · Landscape · World Premiere Cinematic",variant: "l", title: "Video 15 — World Premiere Presentation",  desc: '"WORLD PREMIERE — A Presentation by RHYTHMIX." Gold sweeping lines, spotlight reveal, stat cards, grand finale CTA. Theatrical Hollywood premiere style. Female voiceover.', url: `${baseRaw}/fe3fa65/rhythmix-premiere-60s/renders/rhythmix-premiere-60s.mp4`, hint: "1.9 MB", cta: "⬇ Download Video 15" },
];
const cinematic: Vid[] = [
  { badge: "60s · Landscape · Feature Showcase", variant: "l", title: "Video 11 — The Platform",      desc: 'Full cinematic feature showcase: AI generation, 3D venues, distribution counter, sync licensing earnings, CTA. Five scenes with blur/zoom transitions.', url: `${baseRaw}/519cb44/rhythmix-platform-60s/renders/rhythmix-platform-60s.mp4`, hint: "4.5 MB", cta: "⬇ Download Video 11" },
  { badge: "60s · Landscape · Conversion / CTA", variant: "l", title: "Video 12 — Get It Tonight",     desc: 'Conversion video: browser URL typed in gold, $149 price reveal, feature checklist, pulsing CTA with rhythmixapp.com.au — Michael voice narration.', url: `${baseRaw}/a81e304/rhythmix-getit-60s/renders/rhythmix-getit-60s_2026-05-07_11-18-33.mp4`, hint: "2.3 MB", cta: "⬇ Download Video 12" },
];
const venues: Vid[] = [
  { badge: "30s · Portrait · Disco Club",       variant: "p", title: "Video 7 — Disco Venue",  desc: 'Mirror ball, checker floor, coloured spotlights — "Any Stage. Any Genre."',          url: `${baseRaw}/351b7c5edf6671912809289da620baa0fad7c0ab/rhythmix-venue-disco/renders/rhythmix-venue-disco_2026-05-07_06-01-11.mp4`, hint: "3.5 MB", cta: "⬇ Download Disco Video" },
  { badge: "30s · Portrait · Underground Rave", variant: "p", title: "Video 8 — Rave Venue",   desc: 'Laser grid, UV neon, cyan/magenta particles — "Drop The Bass. Feel Every Beat."',  url: `${baseRaw}/351b7c5edf6671912809289da620baa0fad7c0ab/rhythmix-venue-rave/renders/rhythmix-venue-rave_2026-05-07_06-02-18.mp4`, hint: "4.9 MB", cta: "⬇ Download Rave Video" },
  { badge: "30s · Portrait · Rock Arena",       variant: "p", title: "Video 9 — Rock Venue",   desc: 'Speaker stacks, pyrotechnics, crowd silhouette — "Stadium Sound. From Your Bedroom."', url: `${baseRaw}/351b7c5edf6671912809289da620baa0fad7c0ab/rhythmix-venue-rock/renders/rhythmix-venue-rock_2026-05-07_06-03-20.mp4`, hint: "1.6 MB", cta: "⬇ Download Rock Video" },
  { badge: "30s · Portrait · Jazz Lounge",      variant: "p", title: "Video 10 — Jazz Venue",  desc: 'Velvet curtains, amber spotlight, dust motes — "Soul In Every Note."',             url: `${baseRaw}/351b7c5edf6671912809289da620baa0fad7c0ab/rhythmix-venue-jazz/renders/rhythmix-venue-jazz_2026-05-07_06-04-14.mp4`, hint: "1.6 MB", cta: "⬇ Download Jazz Video" },
];

const badgeClasses = {
  p: "bg-[rgba(255,31,90,.12)] text-[#ff1f5a] border-[rgba(255,31,90,.3)]",
  l: "bg-[rgba(0,216,255,.1)] text-[#00d8ff] border-[rgba(0,216,255,.28)]",
} as const;
const btnClasses = {
  p: "purple-gradient",
  l: "cyan-gradient",
} as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RHYTHMIX — Download Your Videos</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body class="px-5 pt-10 pb-20" style="background:#08050d;">
    <div class="text-center mb-5">
      <a href={`${import.meta.env.BASE_URL}features`} class="text-[#a0a0b0] no-underline text-sm font-semibold">← See All Features</a>
    </div>
    <h1 class="text-[40px] font-black text-center mb-1 brand-gradient-text">RHYTHMIX</h1>
    <p class="text-center text-[#a0a0b0] text-[15px] mb-4">The World's First Complete AI Music Platform</p>

    <div class="flex items-center justify-center gap-2.5 flex-wrap mb-7">
      <span class="gold-gradient text-black text-[13px] font-extrabold tracking-[1px] uppercase px-[18px] py-2 rounded-full">Lifetime Deal · $149</span>
      <span class="bg-[rgba(255,31,90,.15)] text-[#ff1f5a] border border-[rgba(255,31,90,.4)] text-[13px] font-bold px-4 py-2 rounded-full">
        <span class="inline-block w-2 h-2 rounded-full bg-[#ff1f5a] mr-1.5 animate-pulse-dot align-middle"></span>Launching Tonight
      </span>
    </div>

    <div class="border border-[rgba(124,58,237,.4)] rounded-[20px] px-5 py-7 mb-9 text-center" style="background:linear-gradient(135deg,rgba(124,58,237,.2),rgba(0,216,255,.1));">
      <h2 class="text-[22px] font-extrabold mb-1.5">Get Early Access</h2>
      <p class="text-[#a0a0b0] text-sm leading-relaxed mb-5">Lock in the $149 lifetime deal before it's gone.<br />Generate, master, distribute &amp; keep 100% of your royalties.</p>
      <a class="block text-center no-underline cyan-gradient text-white text-lg font-extrabold px-6 py-[18px] rounded-[14px] mb-5" href="https://rhythmixapp.com.au">Join RHYTHMIX Now →</a>
      <label class="text-[13px] text-[#a0a0b0] mb-2.5 block text-left">Or drop your email — we'll send you the link:</label>
      <form action="https://formspree.io/f/mjglrdeo" method="POST">
        <div class="flex gap-2">
          <input type="email" name="email" placeholder="your@email.com" required class="flex-1 bg-white/[.08] border border-white/[.2] rounded-xl text-white text-base px-4 py-3.5 outline-none placeholder:text-[#666] focus:border-[#7c3aed]" />
          <button type="submit" class="purple-gradient text-white text-[15px] font-extrabold border-none rounded-xl px-5 py-3.5 cursor-pointer whitespace-nowrap">Notify Me</button>
        </div>
        <p class="text-xs text-[#555] mt-2 text-left">No spam. Just your early access link.</p>
      </form>
    </div>

    {[
      { label: "── Latest · Just Rendered ──", items: latest },
      { label: "── 30 Second Portrait ── TikTok · Reels · Shorts ──", items: portrait30 },
      { label: "── 60 Second Landscape ── YouTube · Facebook ──", items: landscape60 },
    ].map(group => (
      <>
        <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#a0a0b0] text-center my-8">{group.label}</div>
        {group.items.map(v => (
          <div class="bg-[#1a1325] border border-white/[.08] rounded-[20px] px-[18px] py-[22px] mb-3.5">
            <span class={`inline-block text-[11px] font-bold tracking-[2px] uppercase px-3 py-1 rounded-full mb-2.5 border ${badgeClasses[v.variant]}`}>{v.badge}</span>
            <h2 class="text-[19px] font-bold mb-1.5">{v.title}</h2>
            <p class="text-[13px] text-[#a0a0b0] mb-4 leading-snug">{v.desc}</p>
            <a class={`flex items-center justify-center gap-2.5 no-underline text-white text-[17px] font-bold px-5 py-[17px] rounded-[14px] ${btnClasses[v.variant]}`} href={v.url}>{v.cta}</a>
            <p class="text-center text-[#555] text-xs mt-2">{v.hint}</p>
          </div>
        ))}
      </>
    ))}

    <div class="bg-white/[.04] border border-white/[.08] rounded-2xl p-5 mt-9 text-center">
      <p class="text-[#a0a0b0] text-sm mb-3.5">Share this page with your team or audience</p>
      <div class="flex gap-2.5 justify-center flex-wrap">
        <a class="no-underline text-white text-sm font-bold px-5 py-2.5 rounded-xl border border-white/[.15]" href="https://www.facebook.com/sharer/sharer.php?u=https://rhythmixapp.com.au/downloads" target="_blank" rel="noopener">Facebook</a>
        <a class="no-underline text-white text-sm font-bold px-5 py-2.5 rounded-xl border border-white/[.15]" href="https://twitter.com/intent/tweet?url=https://rhythmixapp.com.au/downloads&text=Check+out+RHYTHMIX+—+The+World's+First+Complete+AI+Music+Platform" target="_blank" rel="noopener">X / Twitter</a>
        <a class="no-underline text-white text-sm font-bold px-5 py-2.5 rounded-xl border border-white/[.15]" href="https://www.linkedin.com/sharing/share-offsite/?url=https://rhythmixapp.com.au/downloads" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>

    {[
      { label: "── World Premiere · Backstory Videos ── All Platforms ──", items: premiere },
      { label: "── 60 Second Cinematic Videos ── YouTube · LinkedIn ──", items: cinematic },
      { label: "── 30 Second Venue Videos ── TikTok · Reels ──", items: venues },
    ].map(group => (
      <>
        <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#a0a0b0] text-center my-8">{group.label}</div>
        {group.items.map(v => (
          <div class="bg-[#1a1325] border border-white/[.08] rounded-[20px] px-[18px] py-[22px] mb-3.5">
            <span class={`inline-block text-[11px] font-bold tracking-[2px] uppercase px-3 py-1 rounded-full mb-2.5 border ${badgeClasses[v.variant]}`}>{v.badge}</span>
            <h2 class="text-[19px] font-bold mb-1.5">{v.title}</h2>
            <p class="text-[13px] text-[#a0a0b0] mb-4 leading-snug">{v.desc}</p>
            <a class={`flex items-center justify-center gap-2.5 no-underline text-white text-[17px] font-bold px-5 py-[17px] rounded-[14px] ${btnClasses[v.variant]}`} href={v.url}>{v.cta}</a>
            <p class="text-center text-[#555] text-xs mt-2">{v.hint}</p>
          </div>
        ))}
      </>
    ))}

    <footer class="text-center text-[#333] text-xs mt-10">rhythmixapp.com.au · The World's First Complete AI Music Platform</footer>
  </body>
</html>
