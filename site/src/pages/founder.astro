---
import "../styles/global.css";

const baseRaw = "https://raw.githubusercontent.com/wiggjamie9-afk/jamie-wigg";
const launchPortrait = [
  { title: "World Announcement",     meta: "30s · Portrait · Video 1", url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-announce-30s/renders/rhythmix-announce-30s_2026-05-07_05-16-10.mp4` },
  { title: "Who Is It For?",         meta: "30s · Portrait · Video 2", url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-who-30s/renders/rhythmix-who-30s_2026-05-07_05-17-01.mp4` },
  { title: "World First + $149 Deal",meta: "30s · Portrait · Video 3", url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-worldfirst-30s/renders/rhythmix-worldfirst-30s_2026-05-07_05-17-41.mp4` },
];
const launchLandscape = [
  { title: "Full Platform Debut",  meta: "60s · Landscape · Video 4", url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-debut-60s/renders/rhythmix-debut-60s_2026-05-07_05-18-32.mp4` },
  { title: "Studio in Your Pocket",meta: "60s · Landscape · Video 5", url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-creator-60s/renders/rhythmix-creator-60s_2026-05-07_05-19-46.mp4` },
  { title: "Musical Revolution",   meta: "60s · Landscape · Video 6", url: `${baseRaw}/0f03c32dd9cf78e932dc76a599fd75f62e378233/rhythmix-era-60s/renders/rhythmix-era-60s_2026-05-07_05-20-49.mp4` },
];
const venues = [
  { title: "Disco Club",       meta: "30s · Portrait · Venue 1", url: `${baseRaw}/351b7c5edf6671912809289da620baa0fad7c0ab/rhythmix-venue-disco/renders/rhythmix-venue-disco_2026-05-07_06-01-11.mp4` },
  { title: "Underground Rave", meta: "30s · Portrait · Venue 2", url: `${baseRaw}/351b7c5edf6671912809289da620baa0fad7c0ab/rhythmix-venue-rave/renders/rhythmix-venue-rave_2026-05-07_06-02-18.mp4` },
  { title: "Rock Arena",       meta: "30s · Portrait · Venue 3", url: `${baseRaw}/351b7c5edf6671912809289da620baa0fad7c0ab/rhythmix-venue-rock/renders/rhythmix-venue-rock_2026-05-07_06-03-20.mp4` },
  { title: "Jazz Lounge",      meta: "30s · Portrait · Venue 4", url: `${baseRaw}/351b7c5edf6671912809289da620baa0fad7c0ab/rhythmix-venue-jazz/renders/rhythmix-venue-jazz_2026-05-07_06-04-14.mp4` },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RHYTHMIX — Founder Access</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="px-5 pt-10 pb-20">
    <p class="text-[22px] font-black text-center mb-10 brand-gradient-text">RHYTHMIX</p>

    <div class="flex items-center justify-center gap-2.5 mb-3">
      <span class="gold-gradient text-black text-[11px] font-black tracking-[3px] uppercase px-5 py-2 rounded-full">⚡ Founder Access</span>
    </div>

    <h1 class="font-black text-center leading-[1.05] mb-3" style="font-size:clamp(32px,8vw,60px);">You built this.<br />You own it. Forever.</h1>
    <p class="text-center text-[#a0a0b0] text-[17px] leading-relaxed">Everything unlocked. No payment. <strong class="text-[#f5c000]">All 10 videos + lifetime access.</strong></p>

    <hr class="border-none border-t border-white/[.06] my-9" />

    <div class="flex justify-center gap-6 flex-wrap mb-10">
      <div class="text-center"><div class="text-[36px] font-black text-[#f5c000] leading-none">10</div><div class="text-xs text-[#555] tracking-[1px] uppercase mt-1">Videos Made</div></div>
      <div class="text-center"><div class="text-[36px] font-black text-[#f5c000] leading-none">$149</div><div class="text-xs text-[#555] tracking-[1px] uppercase mt-1">You Pay: $0</div></div>
      <div class="text-center"><div class="text-[36px] font-black text-[#f5c000] leading-none">∞</div><div class="text-xs text-[#555] tracking-[1px] uppercase mt-1">Access</div></div>
    </div>

    <hr class="border-none border-t border-white/[.06] my-9" />

    <p class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-4 mt-10">Launch Videos — Portrait (TikTok / Reels / Shorts)</p>
    <div class="flex flex-col gap-3">
      {launchPortrait.map(v => (
        <div class="bg-[#0d0d0d] border border-[rgba(245,192,0,.2)] rounded-2xl px-4 py-4 flex justify-between items-center gap-3">
          <div class="flex-1 min-w-0">
            <div class="text-[15px] font-extrabold mb-0.5">{v.title}</div>
            <div class="text-xs text-[#555]">{v.meta}</div>
          </div>
          <a class="gold-gradient text-black text-[13px] font-extrabold px-[18px] py-2.5 rounded-[10px] no-underline whitespace-nowrap flex-shrink-0" href={v.url} download>⬇ Download</a>
        </div>
      ))}
    </div>

    <p class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-4 mt-8">Launch Videos — Landscape (YouTube / LinkedIn)</p>
    <div class="flex flex-col gap-3">
      {launchLandscape.map(v => (
        <div class="bg-[#0d0d0d] border border-[rgba(124,58,237,.2)] rounded-2xl px-4 py-4 flex justify-between items-center gap-3">
          <div class="flex-1 min-w-0">
            <div class="text-[15px] font-extrabold mb-0.5">{v.title}</div>
            <div class="text-xs text-[#555]">{v.meta}</div>
          </div>
          <a class="cyan-gradient text-white text-[13px] font-extrabold px-[18px] py-2.5 rounded-[10px] no-underline whitespace-nowrap flex-shrink-0" href={v.url} download>⬇ Download</a>
        </div>
      ))}
    </div>

    <p class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-4 mt-8">3D Venue Videos — Portrait</p>
    <div class="flex flex-col gap-3">
      {venues.map(v => (
        <div class="bg-[#0d0d0d] border border-[rgba(245,192,0,.2)] rounded-2xl px-4 py-4 flex justify-between items-center gap-3">
          <div class="flex-1 min-w-0">
            <div class="text-[15px] font-extrabold mb-0.5">{v.title}</div>
            <div class="text-xs text-[#555]">{v.meta}</div>
          </div>
          <a class="gold-gradient text-black text-[13px] font-extrabold px-[18px] py-2.5 rounded-[10px] no-underline whitespace-nowrap flex-shrink-0" href={v.url} download>⬇ Download</a>
        </div>
      ))}
    </div>

    <hr class="border-none border-t border-white/[.06] my-9" />

    <div class="border border-[rgba(245,192,0,.25)] rounded-[20px] px-5 py-7 mt-10" style="background:linear-gradient(135deg,rgba(245,192,0,.08),rgba(245,192,0,.02));">
      <h2 class="text-[22px] font-black mb-4 text-[#f5c000]">Your Founder Perks</h2>
      <ul class="list-none flex flex-col gap-2.5">
        <li class="text-[#a0a0b0] text-[15px]"><span class="text-[#00e887] mr-2">✓</span>Lifetime access to RHYTHMIX — $0 forever</li>
        <li class="text-[#a0a0b0] text-[15px]"><span class="text-[#00e887] mr-2">✓</span>All 10 marketing videos — download &amp; post anytime</li>
        <li class="text-[#a0a0b0] text-[15px]"><span class="text-[#00e887] mr-2">✓</span>All future features included the moment they ship</li>
        <li class="text-[#a0a0b0] text-[15px]"><span class="text-[#00e887] mr-2">✓</span>3D venue performances — when released</li>
        <li class="text-[#a0a0b0] text-[15px]"><span class="text-[#00e887] mr-2">✓</span>Cloud music library — when released</li>
        <li class="text-[#a0a0b0] text-[15px]"><span class="text-[#00e887] mr-2">✓</span>Sync licensing marketplace — when released</li>
        <li class="text-[#a0a0b0] text-[15px]"><span class="text-[#00e887] mr-2">✓</span>You built this. That's worth more than $149.</li>
      </ul>
    </div>

    <div class="bg-[#0d0d0d] border border-white/[.08] rounded-[20px] px-5 py-6 mt-5 text-center">
      <h3 class="text-[18px] font-extrabold mb-1.5">Gift someone early access</h3>
      <p class="text-[#a0a0b0] text-[13px] mb-4">Share this code to give a friend the same $149 deal. Code expires when you say so.</p>
      <div class="bg-black border border-[rgba(245,192,0,.3)] rounded-xl px-5 py-3.5 text-[22px] font-black text-[#f5c000] tracking-[4px] font-mono mb-3" id="gift-code">RHYTHMIX2026</div>
      <button class="bg-white/[.08] border border-white/[.15] text-white text-sm font-bold px-5 py-2.5 rounded-[10px] cursor-pointer copy-btn" onclick="copyCode()">Copy Code</button>
    </div>

    <footer class="text-center pt-10 text-[#333] text-xs">
      <p>This page is private. Bookmark it. <a href="/features" class="text-[#555] no-underline">Back to site →</a></p>
    </footer>

    <script is:inline>
      function copyCode() {
        navigator.clipboard.writeText('RHYTHMIX2026').then(function() {
          var btn = document.querySelector('.copy-btn');
          if (!btn) return;
          btn.textContent = 'Copied!';
          setTimeout(function() { btn.textContent = 'Copy Code'; }, 2000);
        });
      }
    </script>
  </body>
</html>
