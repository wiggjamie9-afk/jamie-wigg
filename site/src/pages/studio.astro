---
import "../styles/global.css";
const buyUrl = "https://wiggjamie.gumroad.com/l/rhythmix-studio";
const steps = [
  { n: "Step 01", h: "Plan",   p: "Drop your track and a one-line theme. Studio analyses duration, tempo, and structure — then drafts a beat-aligned scene plan you can preview and tweak before spending a cent." },
  { n: "Step 02", h: "Render", p: "Each scene is auto-routed to the best model for the moment — Kling for cinematic chorus shots, Hunyuan for motion verses, Luma Ray for dreamy bridges. All running in parallel." },
  { n: "Step 03", h: "Share",  pHtml: 'Final cut stitched to the beat with your audio locked in. <code class="bg-[rgba(124,58,237,.15)] text-[#c4b5fd] px-2 py-0.5 rounded-md font-mono text-[13px]">final.mp4</code> ready for TikTok, YouTube, Spotify Canvas, or whatever\'s next.' },
];
const models = [
  { tag: "Cinematic", name: "Kling v2",        desc: "Long, cinematic shots. Used for hero choruses and intros." },
  { tag: "Motion",    name: "Hunyuan Video",   desc: "Fast, stylized motion. Used for verses and b-roll." },
  { tag: "Dreamy",    name: "Luma Ray",        desc: "Smooth camera moves and surreal palettes for bridges." },
  { tag: "Character", name: "MiniMax Hailuo",  desc: "Expressive characters. Cheapest per clip, great for tests." },
];
const faqs = [
  { q: "What am I actually buying tonight?", aHtml: 'You\'re locking in <strong>lifetime access at $149</strong>. RHYTHMIX Studio\'s full member dashboard launches in 14 days — you\'ll get the access link by email then. While you wait, reply to your welcome email with a track + theme and I\'ll render a custom AI music video for you on the house.' },
  { q: "What if I'm not happy?",              aHtml: '30-day money-back guarantee, no questions asked. Reply to your receipt and you\'ll get a full refund within 24 hours. <a href="/refunds" class="text-[#00d8ff]">Full refund policy</a>.' },
  { q: "What does \"lifetime\" actually mean?", aHtml: 'One payment of $149 today. Unlimited use of the engine, all current and future models, every aspect ratio, all future features — forever. No subscription, no auto-renewals, ever.' },
  { q: "Why pre-sale instead of waiting for launch?", aHtml: 'Two reasons — (1) the $149 price is only locked for pre-buyers; regular price after launch will be higher. (2) Pre-buyers get direct access to me to request custom renders during the 14-day window before the full dashboard ships.' },
  { q: "Do I need to know prompting?",        aHtml: 'No. You give Studio a one-line theme — "neon-soaked midnight city, lone musician on rooftop" — and it writes the per-scene prompts for you, varying them by section (intro / verse / chorus / bridge / outro).' },
  { q: "How much does each video cost to render?", aHtml: 'About $5–25 per video depending on length and which models the planner picks. RHYTHMIX Studio uses your own Replicate API key — transparent pass-through, no markup. A 60-second video using the cheapest model (MiniMax Hailuo) runs ~$8.' },
];
const presale = [
  "Pay $149 today — lifetime price locked in",
  "Receipt + welcome email within 24 hours",
  "Full member dashboard live in 14 days",
  "30-day money-back guarantee — no questions asked",
  "Free custom render request while you wait (just reply to your welcome email)",
];
const includes = [
  "Lifetime price locked in tonight",
  "Welcome email + roadmap within 24 hours",
  "Full dashboard launches in 14 days",
  "Unlimited renders, every model, every aspect ratio",
  "30-day money-back guarantee",
  "All future features included — forever",
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RHYTHMIX Studio — Turn Your Music Into Cinematic AI Videos</title>
    <meta name="description" content="Lock in lifetime access at $149. Full launch in 14 days. AI-generated cinematic music videos from any track." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="product" />
    <meta property="og:url" content="https://rhythmixapp.com.au/studio" />
    <meta property="og:title" content="RHYTHMIX Studio — Your Music. As a Movie." />
    <meta property="og:description" content="Lock in lifetime access at $149. Full launch in 14 days. AI-generated cinematic music videos from any track." />
    <meta property="og:image" content="https://rhythmixapp.com.au/thumbnails/rhythmix-thumbnail-square.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="overflow-x-hidden">
    <nav class="flex justify-between items-center px-6 py-5 sticky top-0 z-100 bg-black/85 backdrop-blur-xl border-b border-white/[.06]">
      <a href="/" class="brand-gradient-text text-[22px] font-black no-underline">RHYTHMIX <small class="text-[11px] font-bold tracking-[3px] text-[#a0a0b0] ml-1.5 uppercase" style="-webkit-text-fill-color:#a0a0b0;">Studio</small></a>
      <div class="flex gap-4 items-center">
        <a href="/" class="text-[#a0a0b0] no-underline text-sm font-semibold">Home</a>
        <a href={buyUrl} class="gold-gradient text-black px-5 py-2.5 rounded-full text-sm font-black no-underline">Buy · $149</a>
      </div>
    </nav>

    <div class="text-center px-6 pt-15 pb-14" style="background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(124,58,237,.22),transparent);">
      <div class="flex justify-center gap-2.5 flex-wrap mb-7">
        <span class="gold-gradient text-black text-xs font-black tracking-[2px] uppercase px-[18px] py-2 rounded-full">Lifetime Deal · $149</span>
        <span class="inline-flex items-center gap-2 bg-[rgba(0,232,135,.1)] border border-[rgba(0,232,135,.4)] text-[#00e887] text-xs font-extrabold tracking-[2px] uppercase px-4 py-2 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse-dot"></span>Pre-sale Open
        </span>
      </div>
      <h1 class="font-black leading-none tracking-[-2px] mb-5" style="font-size:clamp(40px,10vw,84px);">
        Your music.<br /><em class="brand-gradient-text not-italic">As a movie.</em>
      </h1>
      <p class="text-[#a0a0b0] leading-relaxed max-w-[580px] mx-auto mb-8" style="font-size:clamp(16px,3vw,20px);">
        Lock in lifetime access at <strong class="text-white">$149</strong> today. Full RHYTHMIX Studio interface launches in <strong class="text-white">14 days</strong>.
      </p>
      <div class="flex gap-3 justify-center flex-wrap mb-4">
        <a href={buyUrl} class="gold-gradient text-black text-lg font-black px-8 py-[18px] rounded-[14px] no-underline inline-block" style="box-shadow:0 0 30px rgba(245,192,0,.25);">Lock In Lifetime Access →</a>
        <a href="#how" class="bg-white/[.08] border border-white/[.15] text-white text-base font-bold px-7 py-[18px] rounded-[14px] no-underline inline-block">How It Works</a>
      </div>
      <p class="text-[#555] text-[13px]">14-day money-back guarantee · <strong class="text-[#a0a0b0]">$149 once</strong> · No subscription, ever</p>
    </div>

    <div class="max-w-[880px] mx-auto mb-10 px-6">
      <video controls muted loop playsinline preload="metadata" poster="/thumbnails/rhythmix-thumbnail-16-9.png" class="w-full block rounded-2xl border border-[rgba(124,58,237,.3)]" style="box-shadow:0 0 40px rgba(124,58,237,.15);">
        <source src="/videos/announcement-live-60s.mp4" type="video/mp4" />
      </video>
      <p class="text-[#a0a0b0] text-[13px] text-center mt-3.5"><strong class="text-white">60-second pitch.</strong> Watch what RHYTHMIX Studio does.</p>
    </div>

    <div class="max-w-[720px] mx-auto mb-10 px-6">
      <div class="border border-[rgba(245,192,0,.3)] rounded-[18px] px-7 py-6" style="background:linear-gradient(135deg,rgba(245,192,0,.08),rgba(255,31,90,.05));">
        <h3 class="text-[13px] font-black tracking-[3px] uppercase text-[#f5c000] mb-2.5">⚡ Pre-sale — What you're buying tonight</h3>
        <p class="text-white text-base leading-snug">RHYTHMIX Studio launches in <strong class="text-[#f5c000]">14 days</strong>. Pre-buyers lock in the lifetime $149 price (regular price will be higher).</p>
        <ul class="list-none mt-3.5">
          {presale.map(item => (
            <li class="text-[#a0a0b0] text-sm py-1.5 flex items-start gap-2.5"><span class="text-[#00e887] font-black flex-none">✓</span>{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <section id="how" class="px-6 py-16 max-w-[880px] mx-auto">
      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3 text-center">How It Works</div>
      <h2 class="font-black leading-[1.1] mb-9 text-center" style="font-size:clamp(28px,5vw,42px);">Three steps. One movie.</h2>
      <div class="grid gap-px bg-white/[.06] rounded-[20px] overflow-hidden" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
        {steps.map(s => (
          <div class="bg-black px-6 py-8">
            <div class="text-[13px] font-black tracking-[3px] text-[#7c3aed] uppercase mb-2">{s.n}</div>
            <h3 class="text-xl font-black mb-2">{s.h}</h3>
            {s.p ? <p class="text-[#a0a0b0] text-sm leading-relaxed">{s.p}</p>
                 : <p class="text-[#a0a0b0] text-sm leading-relaxed" set:html={s.pHtml} />}
          </div>
        ))}
      </div>
    </section>

    <section class="px-6 py-16 max-w-[880px] mx-auto">
      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3 text-center">Powered By</div>
      <h2 class="font-black leading-[1.1] mb-9 text-center" style="font-size:clamp(28px,5vw,42px);">The best models. Picked for you.</h2>
      <div class="bg-[#0d0d0d] border border-white/[.07] rounded-[20px] px-6 py-8">
        <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));">
          {models.map(m => (
            <div class="bg-black border border-white/[.08] rounded-[14px] p-[18px]">
              <div class="text-[10px] font-extrabold tracking-[2px] text-[#7c3aed] uppercase mb-1.5">{m.tag}</div>
              <div class="text-[15px] font-extrabold mb-1">{m.name}</div>
              <div class="text-[#a0a0b0] text-xs leading-snug">{m.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-16 max-w-[880px] mx-auto">
      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3 text-center">First Render</div>
      <h2 class="font-black leading-[1.1] mb-9 text-center" style="font-size:clamp(28px,5vw,42px);">A real one. End-to-end.</h2>
      <video controls muted loop playsinline preload="metadata" poster="/thumbnails/rhythmix-thumbnail-16-9.png" class="w-full rounded-[14px] border border-white/[.08] block">
        <source src="/videos/rhythmix-studio-001.mp4" type="video/mp4" />
      </video>
      <p class="text-[#a0a0b0] text-[13px] text-center mt-3.5">Theme: "neon midnight city, lone figure on rooftop, blade runner aesthetic" · 16 AI scenes · ~25 minutes of compute · ~$8 of Replicate credit.</p>
    </section>

    <div id="buy" class="border border-[rgba(124,58,237,.3)] rounded-3xl px-7 py-12 text-center mx-6 mb-8" style="background:linear-gradient(135deg,#0d0020,#000);">
      <h2 class="font-black mb-2" style="font-size:clamp(28px,6vw,42px);">Lock In Lifetime Access</h2>
      <div class="text-[64px] font-black text-[#f5c000] leading-none my-3.5">$149</div>
      <p class="text-[#a0a0b0] text-[15px] mb-2">One time. Yours forever. No subscription.</p>
      <p class="text-[#00e887] text-[13px] font-extrabold tracking-[2px] uppercase mb-6">⚡ Full launch in 14 days · Price goes up after</p>
      <a href={buyUrl} class="gold-gradient text-black text-xl font-black px-10 py-[22px] rounded-2xl no-underline inline-block" style="box-shadow:0 0 30px rgba(245,192,0,.25);">Buy Now · Lock In $149 →</a>
      <ul class="list-none flex flex-col gap-2 max-w-[380px] mx-auto mt-6">
        {includes.map(item => (
          <li class="text-[#a0a0b0] text-sm text-left"><span class="text-[#00e887] mr-2">✓</span>{item}</li>
        ))}
      </ul>
      <div class="text-[#444] text-xs tracking-[3px] uppercase mt-8 mb-4">— not buying yet? —</div>
      <form class="flex gap-2.5 max-w-[460px] mx-auto" action="https://formsubmit.co/jamie28rhythmixapp@yahoo.com" method="POST">
        <input type="email" name="email" placeholder="your@email.com" required class="flex-1 bg-white/[.08] border border-white/[.15] rounded-xl text-white text-base px-[18px] py-4 outline-none placeholder:text-[#444]" />
        <input type="hidden" name="_subject" value="RHYTHMIX Studio waitlist signup" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <button type="submit" class="purple-gradient text-white text-[15px] font-black border-none rounded-xl px-[22px] py-4 cursor-pointer whitespace-nowrap">Get Launch Updates</button>
      </form>
      <p class="text-[#555] text-xs mt-3.5">No spam. Updates only when something ships.</p>
    </div>

    <section class="px-6 py-16 max-w-[880px] mx-auto">
      <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3 text-center">FAQ</div>
      <h2 class="font-black leading-[1.1] mb-9 text-center" style="font-size:clamp(28px,5vw,42px);">The answers.</h2>
      <div class="flex flex-col gap-2.5">
        {faqs.map(f => (
          <details class="bg-[#0d0d0d] border border-white/[.07] rounded-[14px] px-5 py-[18px] [&_summary::-webkit-details-marker]:hidden">
            <summary class="cursor-pointer text-[15px] font-extrabold list-none flex justify-between items-start gap-3">
              <span>{f.q}</span>
              <span class="text-[#7c3aed] text-xl leading-none flex-none">+</span>
            </summary>
            <p class="text-[#a0a0b0] text-sm leading-relaxed mt-3" set:html={f.aHtml} />
          </details>
        ))}
      </div>
    </section>

    <footer class="text-center px-6 py-10 text-[#333] text-[13px] border-t border-white/[.05]">
      <p>
        <a href="/" class="text-[#444] no-underline mx-2 hover:text-[#a0a0b0]">Home</a> ·
        <a href="/features" class="text-[#444] no-underline mx-2 hover:text-[#a0a0b0]">Features</a> ·
        <a href="/downloads" class="text-[#444] no-underline mx-2 hover:text-[#a0a0b0]">Videos</a> ·
        <a href="/privacy" class="text-[#444] no-underline mx-2 hover:text-[#a0a0b0]">Privacy</a> ·
        <a href="/terms" class="text-[#444] no-underline mx-2 hover:text-[#a0a0b0]">Terms</a> ·
        <a href="/refunds" class="text-[#444] no-underline mx-2 hover:text-[#a0a0b0]">Refunds</a>
      </p>
      <p class="mt-2.5">© 2026 RHYTHMIX</p>
    </footer>
  </body>
</html>
