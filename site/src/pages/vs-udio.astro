---
import Base from "../layouts/Base.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import StickyBuyCta from "../components/StickyBuyCta.astro";

const buyUrl = "https://wiggjamie.gumroad.com/l/rhythmix-studio";
---
<Base
  title="RHYTHMIX vs Udio — One-time $149 vs subscription forever"
  description="Udio is a great Suno alternative — but it's still a subscription, still gen-only. RHYTHMIX is one payment with mastering and 120+ platform distribution baked in."
  url="https://rhythmixapp.com.au/vs-udio"
>
  <section class="text-center px-6 pt-16 pb-10" style="background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(124,58,237,.18),transparent);">
    <a href={`${import.meta.env.BASE_URL}compare`} class="text-[#555] text-[11px] font-bold tracking-[3px] uppercase no-underline hover:text-[#a0a0b0]">← All comparisons</a>
    <h1 class="font-black leading-[1.05] tracking-[-1.5px] mt-6 mb-5" style="font-size:clamp(36px,8vw,64px);">
      RHYTHMIX vs <em class="brand-gradient-text not-italic">Udio.</em>
    </h1>
    <p class="text-[#a0a0b0] leading-relaxed max-w-[640px] mx-auto" style="font-size:clamp(15px,2.5vw,18px);">
      Udio's the audiophile pick — strong vocal coherence, clean stems. Here's the honest side-by-side, including <strong class="text-white">when Udio is the right call.</strong>
    </p>
  </section>

  <section class="px-6 pb-12 max-w-[820px] mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10">
      <div class="rounded-2xl bg-[#0d0d0d] border border-white/[.08] px-5 py-5">
        <div class="text-[11px] font-bold tracking-[2px] uppercase text-[#555] mb-1.5">Sticker price</div>
        <div class="text-2xl font-black brand-gradient-text">$149 once</div>
        <div class="text-[#555] text-xs mt-1">vs Udio Pro $30/mo</div>
      </div>
      <div class="rounded-2xl bg-[#0d0d0d] border border-white/[.08] px-5 py-5">
        <div class="text-[11px] font-bold tracking-[2px] uppercase text-[#555] mb-1.5">Pipeline</div>
        <div class="text-2xl font-black text-white">Gen → Master → Ship</div>
        <div class="text-[#555] text-xs mt-1">Udio: gen only</div>
      </div>
      <div class="rounded-2xl bg-[#0d0d0d] border border-white/[.08] px-5 py-5">
        <div class="text-[11px] font-bold tracking-[2px] uppercase text-[#555] mb-1.5">Royalties</div>
        <div class="text-2xl font-black text-white">100% yours</div>
        <div class="text-[#555] text-xs mt-1">Udio: Pro plan only</div>
      </div>
    </div>

    <ComparisonTable show={["udio"]} />
  </section>

  <section class="px-6 pb-16 max-w-[760px] mx-auto">
    <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3 text-center">The honest verdict</div>
    <h2 class="font-black leading-[1.1] mb-9 text-center" style="font-size:clamp(26px,5vw,36px);">When Udio is actually the better pick</h2>
    <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d] mb-3.5">
      <h3 class="text-lg font-extrabold mb-2">You're chasing maximum vocal realism today</h3>
      <p class="text-[#a0a0b0] text-sm leading-relaxed">Udio's strength is vocal coherence and natural phrasing. If your priority is "does it sound like a real singer," Udio still edges everyone else on that single axis.</p>
    </div>
    <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d] mb-3.5">
      <h3 class="text-lg font-extrabold mb-2">You need clean instrument stems for remixing</h3>
      <p class="text-[#a0a0b0] text-sm leading-relaxed">Udio's stem separation is best-in-class. If you're a producer using AI as a sketch tool to remix, that workflow alone might justify the subscription.</p>
    </div>
    <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d]">
      <h3 class="text-lg font-extrabold mb-2">You're a light user with no plans to release</h3>
      <p class="text-[#a0a0b0] text-sm leading-relaxed">Udio's free tier is generous and Pro at $10/mo is reasonable for occasional use. If you'll never publish to Spotify, you don't need RHYTHMIX's pipeline.</p>
    </div>
  </section>

  <section class="px-6 pb-16 max-w-[760px] mx-auto">
    <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#f5c000] mb-3 text-center">Where RHYTHMIX wins</div>
    <h2 class="font-black leading-[1.1] mb-9 text-center" style="font-size:clamp(26px,5vw,36px);">Why people leave Udio</h2>
    <div class="flex flex-col gap-3">
      <div class="rounded-[20px] px-6 py-6 border border-[rgba(245,192,0,.25)]" style="background:linear-gradient(135deg,rgba(245,192,0,.08),rgba(245,192,0,.02));">
        <h3 class="text-lg font-extrabold mb-1.5">💰 The subscription tax adds up</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">Udio Pro is $30/month. Three years on Udio = $1,080. RHYTHMIX = $149 forever.</p>
      </div>
      <div class="rounded-[20px] px-6 py-6 border border-[rgba(0,232,135,.25)]" style="background:linear-gradient(135deg,rgba(0,232,135,.08),rgba(0,232,135,.02));">
        <h3 class="text-lg font-extrabold mb-1.5">🌍 Generation isn't shipping</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">Udio gives you a download. Then you still need DistroKid ($23/yr), a mastering tool ($15/mo), tagging software, royalty splits — RHYTHMIX bundles every step.</p>
      </div>
      <div class="rounded-[20px] px-6 py-6 border border-[rgba(124,58,237,.3)]" style="background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(124,58,237,.02));">
        <h3 class="text-lg font-extrabold mb-1.5">📱 From your phone, no laptop required</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">Idea → released single, all from a phone on the bus. Udio's web app technically works on mobile but the workflow assumes a desktop.</p>
      </div>
    </div>
  </section>

  <section class="px-6 pb-24 max-w-[700px] mx-auto">
    <div class="border border-[rgba(124,58,237,.3)] rounded-3xl px-7 py-12 text-center" style="background:linear-gradient(135deg,#0d0020,#000);">
      <h2 class="font-black mb-3" style="font-size:clamp(28px,6vw,42px);">Stop renting your studio.</h2>
      <p class="text-[#a0a0b0] text-base mb-7 max-w-[480px] mx-auto leading-relaxed">30-day refund. Try the full pipeline, keep what you make either way.</p>
      <a href={buyUrl} class="gold-gradient text-black text-xl font-black px-10 py-[22px] rounded-2xl no-underline inline-block" style="box-shadow:0 0 30px rgba(245,192,0,.25);">Try RHYTHMIX — $149 →</a>
    </div>
  </section>

  <StickyBuyCta href={buyUrl} />
</Base>
