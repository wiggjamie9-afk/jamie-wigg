---
import Base from "../layouts/Base.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import StickyBuyCta from "../components/StickyBuyCta.astro";

const buyUrl = "https://wiggjamie.gumroad.com/l/rhythmix-studio";
---
<Base
  title="RHYTHMIX vs ACE-Step UI — When the free option costs more than $149"
  description="ACE-Step UI is free, open source, and brilliant. It also requires a 12GB+ NVIDIA GPU, terminal skills, and a free afternoon. Honest comparison for the rest of us."
  url="https://rhythmixapp.com.au/vs-ace-step"
>
  <section class="text-center px-6 pt-16 pb-10" style="background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(124,58,237,.18),transparent);">
    <a href="/compare" class="text-[#555] text-[11px] font-bold tracking-[3px] uppercase no-underline hover:text-[#a0a0b0]">← All comparisons</a>
    <h1 class="font-black leading-[1.05] tracking-[-1.5px] mt-6 mb-5" style="font-size:clamp(36px,8vw,64px);">
      RHYTHMIX vs <em class="brand-gradient-text not-italic">ACE-Step UI.</em>
    </h1>
    <p class="text-[#a0a0b0] leading-relaxed max-w-[640px] mx-auto" style="font-size:clamp(15px,2.5vw,18px);">
      ACE-Step UI is free, open source, and genuinely impressive. It also needs a 12GB+ NVIDIA GPU, a Python environment, and a free afternoon. <strong class="text-white">Free isn't always cheap.</strong>
    </p>
  </section>

  <section class="px-6 pb-12 max-w-[820px] mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10">
      <div class="rounded-2xl bg-[#0d0d0d] border border-white/[.08] px-5 py-5">
        <div class="text-[11px] font-bold tracking-[2px] uppercase text-[#555] mb-1.5">Setup time</div>
        <div class="text-2xl font-black brand-gradient-text">30 seconds</div>
        <div class="text-[#555] text-xs mt-1">vs ACE-Step 1–3 hours</div>
      </div>
      <div class="rounded-2xl bg-[#0d0d0d] border border-white/[.08] px-5 py-5">
        <div class="text-[11px] font-bold tracking-[2px] uppercase text-[#555] mb-1.5">Hardware</div>
        <div class="text-2xl font-black text-white">Phone or laptop</div>
        <div class="text-[#555] text-xs mt-1">ACE-Step: NVIDIA GPU 4GB+</div>
      </div>
      <div class="rounded-2xl bg-[#0d0d0d] border border-white/[.08] px-5 py-5">
        <div class="text-[11px] font-bold tracking-[2px] uppercase text-[#555] mb-1.5">Distribution</div>
        <div class="text-2xl font-black text-white">120+ platforms</div>
        <div class="text-[#555] text-xs mt-1">ACE-Step: export only</div>
      </div>
    </div>

    <ComparisonTable show={["acestep"]} />
  </section>

  <section class="px-6 pb-16 max-w-[760px] mx-auto">
    <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-3 text-center">The honest verdict</div>
    <h2 class="font-black leading-[1.1] mb-9 text-center" style="font-size:clamp(26px,5vw,36px);">When ACE-Step UI is the right pick</h2>
    <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d] mb-3.5">
      <h3 class="text-lg font-extrabold mb-2">You already own a 12GB+ NVIDIA GPU</h3>
      <p class="text-[#a0a0b0] text-sm leading-relaxed">If you have an RTX 3090, 4080, 4090, or equivalent sitting in a desktop you built, ACE-Step runs locally with full control and zero cost per generation. That's a genuinely good deal.</p>
    </div>
    <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d] mb-3.5">
      <h3 class="text-lg font-extrabold mb-2">You're a developer or model researcher</h3>
      <p class="text-[#a0a0b0] text-sm leading-relaxed">Open weights, local fine-tuning, full prompt control, no rate limits, no telemetry. If you want to hack on the model itself or run a research workflow, ACE-Step is the only choice.</p>
    </div>
    <div class="rounded-[20px] px-6 py-7 border border-white/[.08] bg-[#0d0d0d]">
      <h3 class="text-lg font-extrabold mb-2">Privacy is non-negotiable</h3>
      <p class="text-[#a0a0b0] text-sm leading-relaxed">Everything runs offline after setup. Nothing leaves your machine. For sensitive client work or commercial pitches under NDA, that matters more than any UX.</p>
    </div>
  </section>

  <section class="px-6 pb-16 max-w-[760px] mx-auto">
    <div class="text-[11px] font-bold tracking-[4px] uppercase text-[#f5c000] mb-3 text-center">Where RHYTHMIX wins</div>
    <h2 class="font-black leading-[1.1] mb-9 text-center" style="font-size:clamp(26px,5vw,36px);">Why most people pick the paid path anyway</h2>
    <div class="flex flex-col gap-3">
      <div class="rounded-[20px] px-6 py-6 border border-[rgba(245,192,0,.25)]" style="background:linear-gradient(135deg,rgba(245,192,0,.08),rgba(245,192,0,.02));">
        <h3 class="text-lg font-extrabold mb-1.5">📱 No GPU. No terminal. No Python.</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">RHYTHMIX runs from your phone. ACE-Step UI assumes a desktop with NVIDIA hardware — most people don't have one. A budget RTX 4060 alone is ~$300+ before you've made a single track.</p>
      </div>
      <div class="rounded-[20px] px-6 py-6 border border-[rgba(0,232,135,.25)]" style="background:linear-gradient(135deg,rgba(0,232,135,.08),rgba(0,232,135,.02));">
        <h3 class="text-lg font-extrabold mb-1.5">🌍 Generation isn't shipping</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">ACE-Step gives you a WAV file. Then you still need mastering, a distribution service, royalty splits, tagging — all on your own. RHYTHMIX bundles every step.</p>
      </div>
      <div class="rounded-[20px] px-6 py-6 border border-[rgba(124,58,237,.3)]" style="background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(124,58,237,.02));">
        <h3 class="text-lg font-extrabold mb-1.5">⏱️ Your time is the actual cost</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">Free software costs the hours you spend installing CUDA, debugging Python deps, and managing model updates. If your time is worth more than $50/hr, RHYTHMIX pays for itself before the first ACE-Step install finishes.</p>
      </div>
    </div>
  </section>

  <section class="px-6 pb-24 max-w-[700px] mx-auto">
    <div class="border border-[rgba(124,58,237,.3)] rounded-3xl px-7 py-12 text-center" style="background:linear-gradient(135deg,#0d0020,#000);">
      <h2 class="font-black mb-3" style="font-size:clamp(28px,6vw,42px);">Skip the setup. Make a song.</h2>
      <p class="text-[#a0a0b0] text-base mb-7 max-w-[480px] mx-auto leading-relaxed">30-day money-back guarantee. The whole pipeline, on your phone, in 30 seconds — or full refund.</p>
      <a href={buyUrl} class="gold-gradient text-black text-xl font-black px-10 py-[22px] rounded-2xl no-underline inline-block" style="box-shadow:0 0 30px rgba(245,192,0,.25);">Try RHYTHMIX — $149 →</a>
    </div>
  </section>

  <StickyBuyCta href={buyUrl} />
</Base>
