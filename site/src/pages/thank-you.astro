---
import "../styles/global.css";
const steps = [
  { n: 1, h: "Confirmation email — within minutes", p: "Gumroad sends your receipt to the email you used at checkout. Save it — it's proof of your lifetime price." },
  { n: 2, h: "Welcome email — within 24 hours", p: "You'll get a personal email from Jamie with a private welcome video, the full feature roadmap, and a Discord invite for early access members." },
  { n: 3, h: "Full launch — 14 days from today", p: "Member dashboard goes live with the full RHYTHMIX Studio interface. You'll get the access link by email. Until then, every render request you send (just reply to the welcome email with a track + theme) is on the house." },
  { n: 4, h: "Yours forever", p: "Unlimited renders. Every model. Every aspect ratio. All future features included. You paid once." },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to RHYTHMIX Studio — You're In</title>
    <meta name="description" content="Thanks for joining RHYTHMIX Studio early access. Full launch in 14 days." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rhythmixapp.com.au/thank-you" />
    <meta property="og:title" content="Welcome to RHYTHMIX Studio — You're In" />
    <meta property="og:description" content="Lifetime access locked in at $149. Full launch in 14 days." />
    <meta property="og:image" content="https://rhythmixapp.com.au/thumbnails/rhythmix-thumbnail-square.png" />
  </head>
  <body class="pb-10">
    <nav class="flex justify-between items-center px-6 py-5 sticky top-0 z-100 bg-black/85 backdrop-blur-xl border-b border-white/[.06]">
      <a href="/" class="brand-gradient-text text-[22px] font-black no-underline">RHYTHMIX <small class="text-[11px] font-bold tracking-[3px] text-[#a0a0b0] ml-1.5 uppercase" style="-webkit-text-fill-color:#a0a0b0;">Studio</small></a>
      <div><a href="/" class="text-[#a0a0b0] no-underline text-sm font-semibold">Home</a></div>
    </nav>

    <div class="text-center px-6 pt-20 pb-10" style="background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(0,232,135,.18),transparent 70%);">
      <div class="inline-flex items-center justify-center w-[88px] h-[88px] rounded-full text-black text-[48px] font-black leading-none mb-7" style="background:linear-gradient(135deg,#00e887,#00b870);box-shadow:0 0 60px rgba(0,232,135,.35);">✓</div>
      <h1 class="font-black leading-none tracking-[-2px] mb-4" style="font-size:clamp(36px,8vw,68px);">You're <em class="brand-gradient-text not-italic">in.</em></h1>
      <p class="text-[#a0a0b0] leading-relaxed max-w-[560px] mx-auto mb-7" style="font-size:clamp(16px,3vw,20px);">Thanks for joining RHYTHMIX Studio early access. Your <strong class="text-white">$149 lifetime price</strong> is locked in. Full access launches in <strong class="text-white">14 days</strong>.</p>
      <div class="inline-flex items-center gap-2.5 bg-[rgba(245,192,0,.1)] border border-[rgba(245,192,0,.4)] text-[#f5c000] px-6 py-3 rounded-full text-sm font-extrabold tracking-[2px] uppercase">⚡ LIFETIME PRICE LOCKED IN</div>
    </div>

    <div class="max-w-[720px] mx-auto mt-15 px-6">
      <h2 class="text-[11px] font-bold tracking-[4px] uppercase text-[#7c3aed] mb-6 text-center">What happens next</h2>
      {steps.map(({ n, h, p }) => (
        <div class="flex gap-5 p-6 bg-[#0d0d0d] border border-white/[.07] rounded-2xl mb-3">
          <div class="flex-none w-14 h-14 rounded-full flex items-center justify-center text-2xl font-black" style="background:linear-gradient(135deg,#7c3aed,#00d8ff);">{n}</div>
          <div>
            <h3 class="text-[18px] font-black mb-1.5">{h}</h3>
            <p class="text-[#a0a0b0] text-sm leading-relaxed">{p}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="max-w-[720px] mx-auto mt-12 px-6">
      <div class="bg-[#0d0d0d] border border-white/[.07] rounded-2xl p-6 mb-3">
        <h3 class="text-[15px] font-black mb-2 text-[#f5c000] tracking-[2px] uppercase">Need to reach me?</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">Reply to the confirmation email or DM <a href="https://instagram.com/wiggjamie9" class="text-[#00d8ff] no-underline font-bold">@wiggjamie9</a> on Instagram or TikTok. I read every message personally.</p>
      </div>
      <div class="bg-[#0d0d0d] border border-white/[.07] rounded-2xl p-6 mb-3">
        <h3 class="text-[15px] font-black mb-2 text-[#f5c000] tracking-[2px] uppercase">30-day money-back</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">If you're not happy in the first 30 days for any reason, reply to your receipt and you'll get a full refund. <a href="/refunds" class="text-[#00d8ff] no-underline font-bold">Refund policy</a>.</p>
      </div>
      <div class="bg-[#0d0d0d] border border-white/[.07] rounded-2xl p-6 mb-3">
        <h3 class="text-[15px] font-black mb-2 text-[#f5c000] tracking-[2px] uppercase">Spread the word</h3>
        <p class="text-[#a0a0b0] text-sm leading-relaxed">Forward your favourite person the link — <a href="/studio" class="text-[#00d8ff] no-underline font-bold">rhythmixapp.com.au/studio</a>. Lifetime price stays at $149 until launch day.</p>
      </div>
    </div>

    <footer class="text-center px-6 pt-12 text-[#333] text-[13px]">
      <p>
        <a href="/" class="text-[#444] no-underline mx-1.5 hover:text-[#a0a0b0]">Home</a> ·
        <a href="/studio" class="text-[#444] no-underline mx-1.5 hover:text-[#a0a0b0]">Studio</a> ·
        <a href="/privacy" class="text-[#444] no-underline mx-1.5 hover:text-[#a0a0b0]">Privacy</a> ·
        <a href="/terms" class="text-[#444] no-underline mx-1.5 hover:text-[#a0a0b0]">Terms</a> ·
        <a href="/refunds" class="text-[#444] no-underline mx-1.5 hover:text-[#a0a0b0]">Refunds</a>
      </p>
      <p class="mt-2.5">© 2026 RHYTHMIX</p>
    </footer>
  </body>
</html>
