# Long-cache hashed Astro build assets (CSS/JS bundle with content hash in name)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — short cache, must-revalidate so updates propagate fast
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Favicons + thumbnails — week-long cache
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/thumbnails/*
  Cache-Control: public, max-age=604800

# Security headers (apply to everything)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
