# Database
DATABASE_URL=postgresql://user:password@localhost:5432/neural_twin_dev

# Server
NODE_ENV=development
PORT=3000
JWT_SECRET=your-secret-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:3001

# Anthropic API
ANTHROPIC_API_KEY=your-api-key-here

# AWS / File Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_S3_BUCKET=neural-twin-audio

# Redis (for caching and job queue)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
