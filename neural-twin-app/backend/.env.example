# =====================
# NEURAL TWIN BACKEND .env
# =====================

# DATABASE
# Get from Neon (https://console.neon.tech) or Supabase (https://supabase.com/dashboard)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/neural_twin_dev

# API KEYS
# Get from https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# JWT / SECURITY
# Generate 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-key-here

# SERVER CONFIGURATION
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# CORS
# Adjust for your frontend URL in production
CORS_ORIGIN=http://localhost:3000,http://localhost:8000

# CLAUDE MODEL
CLAUDE_MODEL=claude-opus-4-8

# SESSION
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-here

# OPTIONAL: Email Service (Phase 2.5)
# SENDGRID_API_KEY=your-sendgrid-key
# EMAIL_FROM=noreply@neuraltwin.app

# OPTIONAL: Stripe (Phase 3)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
