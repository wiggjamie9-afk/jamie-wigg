<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext (plain HTTP) traffic ONLY to the local development backend.
  - 10.0.2.2 is the Android emulator's alias for the host machine's localhost,
    so this reaches the Neural Twin backend running in Docker on the dev's Mac.
  - 10.0.3.2 is the Genymotion equivalent.
  - localhost covers on-device port forwarding (adb reverse tcp:5000 tcp:5000).

  Everything else still requires HTTPS. When the backend is deployed to a public
  host (Railway/Render/Fly), the app will talk to it over HTTPS and this config
  becomes irrelevant to production traffic.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
