# Keystore Configuration (for signing APKs/App Bundles)
# Copy this to signing.properties and fill in your actual values
# signing.properties should NEVER be committed to version control

# Path to the keystore file (generated via keytool)
SIGNING_STORE_FILE=keystore.jks

# Keystore password (same password used when creating the keystore)
SIGNING_STORE_PASSWORD=your_keystore_password_here

# Key alias (the name of your key entry in the keystore)
SIGNING_KEY_ALIAS=neural_twin_key

# Key password (password for the specific key entry)
SIGNING_KEY_PASSWORD=your_key_password_here
