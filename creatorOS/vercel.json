{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install",
  "devCommand": "next dev",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@supabase_url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase_service_role_key",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "@stripe_publishable_key",
    "STRIPE_SECRET_KEY": "@stripe_secret_key",
    "STRIPE_WEBHOOK_SECRET": "@stripe_webhook_secret",
    "REPLICATE_API_TOKEN": "@replicate_api_token",
    "RESEND_API_KEY": "@resend_api_key",
    "ELEVENLABS_API_KEY": "@elevenlabs_api_key",
    "ANTHROPIC_API_KEY": "@anthropic_api_key"
  },
  "rewrites": [
    {
      "source": "/landing-video",
      "destination": "/landing-ai-video-generator.html"
    },
    {
      "source": "/landing-scheduler",
      "destination": "/landing-social-media-scheduler.html"
    },
    {
      "source": "/landing-music",
      "destination": "/landing-ai-music-generator.html"
    },
    {
      "source": "/landing-image",
      "destination": "/landing-ai-image-generator.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
