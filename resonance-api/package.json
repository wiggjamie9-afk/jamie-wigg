{
  "name": "resonance-api",
  "version": "0.1.0",
  "description": "RESONANCE backend API - Express.js + TypeScript",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "anthropic": "^0.17.1",
    "stripe": "^14.7.0",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "firebase": "^10.7.1",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "@types/jest": "^29.5.11"
  }
}
