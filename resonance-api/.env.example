# RESONANCE API Configuration

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://resonance.local

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/resonance
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
REFRESH_SECRET=your-super-secret-refresh-key
OAUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-secret

# Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Text-to-Speech
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Voicebox (Local Voice Cloning)
VOICEBOX_URL=http://127.0.0.1:17493

# Apple HealthKit Bridge
APPLE_HEALTHKIT_CLIENT_ID=your-client-id
APPLE_HEALTHKIT_CLIENT_SECRET=your-client-secret

# Google Fit Bridge
GOOGLE_FIT_CLIENT_ID=your-client-id
GOOGLE_FIT_CLIENT_SECRET=your-client-secret

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Firebase (Real-time Sync)
FIREBASE_PROJECT_ID=resonance-project
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=firebase@resonance.iam.gserviceaccount.com

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# Monitoring
SENTRY_DSN=your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key

# Admin
ADMIN_EMAIL=admin@resonance.local
ADMIN_PASSWORD=change-this-in-production
