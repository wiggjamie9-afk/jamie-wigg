# Optional API keys for AI generation in Claude Code on the web.
# Copy this file to `.env` (gitignored) for LOCAL use, OR paste the same
# KEY=value lines into the Claude Code web environment's "Environment
# variables" field for CLOUD use. The cloud field uses .env format —
# don't wrap values in quotes.
#
# Network access requirement:
# Change the environment's "Network access" dropdown from "Trusted" to
# "Full". Without that, Claude in the cloud sandbox can't reach the
# CDNs these services return their outputs from.

# Replicate — universal AI backbone (~10,000 models: Flux, HunyuanVideo,
# Wan 2.1, MusicGen, etc.). Cheapest, most flexible. ~$5–10/mo typical
# pay-as-you-go. Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your-token-here

# Higgsfield — Soul (text-to-image with character refs), DOP
# (image-to-video with motion presets), Speech-to-Video (talking heads).
# Per-clip credits. Get keys at https://platform.higgsfield.ai
HIGGSFIELD_API_KEY=your-api-key-here
HIGGSFIELD_SECRET=your-secret-here

# ElevenLabs — pro voice cloning, much better than local Kokoro.
# $5–22/mo. Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=your-api-key-here
