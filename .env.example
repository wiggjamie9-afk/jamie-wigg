# Higgsfield AI MCP server credentials.
# Copy this file to `.env` (gitignored) and replace the values.
# Get keys from https://platform.higgsfield.ai
HIGGSFIELD_API_KEY=your-api-key-here
HIGGSFIELD_SECRET=your-secret-here

# AiToEarn MCP server (multi-platform publish + monetize).
# Get a key from https://aitoearn.ai (international) or https://aitoearn.cn (China).
# Region/key mismatch returns 401 — match the .mcp.json URL to the key's region.
# If you generated the key on aitoearn.cn, swap the URL in .mcp.json to
#   https://aitoearn.cn/api/unified/mcp
AITOEARN_API_KEY=your-aitoearn-key-here

# PostHog (product analytics — used in index.html for conversion attribution).
# Public key only — safe to embed in client-side HTML.
# Find at https://app.posthog.com/project/settings under "Project API Key".
POSTHOG_PUBLIC_KEY=phc_your-public-key-here
