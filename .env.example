# StepFun Step 3.7 Flash — script & story generation MCP server.
# Get key at https://platform.stepfun.ai (Global) or https://platform.stepfun.com (China).
# Global: STEP_BASE_URL=https://api.stepfun.ai/v1
# China:  STEP_BASE_URL=https://api.stepfun.com/v1
STEP_API_KEY=your-stepfun-api-key-here
STEP_BASE_URL=https://api.stepfun.ai/v1

# Higgsfield AI MCP server credentials.
# Copy this file to `.env` (gitignored) and replace the values.
# Get keys from https://platform.higgsfield.ai
HIGGSFIELD_API_KEY=your-api-key-here
HIGGSFIELD_SECRET=your-secret-here

# Context7 MCP server (https://mcp.context7.com/mcp). Anonymous tier works
# without a key but is rate-limited. Free key at https://context7.com/dashboard.
CONTEXT7_API_KEY=your-api-key-here

# FreeLLMAPI — Aggregate free LLM providers (Groq, Gemini, Mistral, etc.)
# See infra/freellmapi/SETUP.md for detailed setup instructions.
# LLM_MODE: "free" (FreeLLMAPI), "paid" (Claude), or "auto" (prefer free if available)
LLM_MODE=auto
FREELLM_URL=http://localhost:3001/v1
FREELLM_API_KEY=freellmapi-your-unified-key-here

# ============================================================================
# Role-Based LLM Configuration (ECC Agent Routing)
# ============================================================================
# Define ordered lists of provider:model for different task complexities.
# Agents auto-select based on task requirements and credential availability.
# Ordered fallback: if first provider unavailable, try next in list.
# Format: provider1:model1,provider2:model2,... (colon-separated, comma-delimited)

# DEFAULT_LLMS: Production, high-stakes tasks (code review, security, architecture)
# Use: high-quality, reasoning-capable models
DEFAULT_LLMS=anthropic:claude-opus-4-8,anthropic:claude-sonnet-4-6

# ECONOMY_LLMS: Cost-optimized, repetitive tasks (file reads, simple edits, formatting)
# Use: fast, cheap models (Haiku tier, Groq, etc.)
ECONOMY_LLMS=anthropic:claude-haiku-4-5,groq:mixtral-8x7b-32768

# CHAT_LLMS: Conversational, lower latency (user interaction, brainstorming, creative)
# Use: fast, conversational models
CHAT_LLMS=anthropic:claude-sonnet-4-6,anthropic:claude-haiku-4-5

# NANO_LLMS: Ultra-lightweight, embedded tasks (quick summaries, classifications)
# Use: smallest, fastest models
NANO_LLMS=groq:mixtral-8x7b-32768,anthropic:claude-haiku-4-5

# DRAFT_LLMS: Draft generation, rapid iteration (first pass code, outlines)
# Use: speed-over-perfection models
DRAFT_LLMS=anthropic:claude-haiku-4-5,groq:mixtral-8x7b-32768

# Provider credentials (only needed for models listed above)
ANTHROPIC_API_KEY=your-claude-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
