# Required for AI drafting
ANTHROPIC_API_KEY=

# Required for live posting to Reddit (https://www.reddit.com/prefs/apps -> create app, type "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=trendbot/0.1 by your_reddit_username

# Where to post (a sub you own/mod, or your u/username profile via u_<name>)
REDDIT_TARGET_SUBREDDIT=u_your_reddit_username

# Behaviour
TRENDBOT_REGION=US
TRENDBOT_MAX_POSTS_PER_RUN=1
TRENDBOT_MIN_MINUTES_BETWEEN_POSTS=120
TRENDBOT_MODEL=claude-sonnet-4-6
