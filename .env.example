# Root Project Environment Variables

# Creative AI Stack (Replicate + ElevenLabs)
REPLICATE_API_TOKEN=your-replicate-api-token
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Higgsfield AI (text-to-image, image-to-video)
HIGGSFIELD_API_KEY=your-higgsfield-api-key
HIGGSFIELD_SECRET=your-higgsfield-secret

# Step.fun Flash MCP (script generation)
STEP_API_KEY=your-step-api-key
STEP_BASE_URL=https://api.step.fun

# Context7 (library documentation)
CONTEXT7_API_KEY=your-context7-api-key

# Google Gemini (image generation)
GOOGLE_API_KEY=your-google-api-key

# GitHub (optional)
GITHUB_TOKEN=your-github-token

# Development
DEBUG=false
NODE_ENV=development
