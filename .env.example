# .env.example — Copy to .env.local and fill in your values
# NEVER commit .env.local to git

# ============================================================================
# SUPABASE (Database + Auth)
# ============================================================================
# Create project at https://supabase.com/dashboard
# Settings → API → Copy these values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ============================================================================
# STRIPE (Payments)
# ============================================================================
# Create account at https://stripe.com
# Developers → API keys → Copy these values
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# SMS GATEWAY (HerdCheck Agent)
# ============================================================================
# Twilio: https://www.twilio.com (global)
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# AI/CONTENT APIS
# ============================================================================

# Replicate (image/video generation for Studio)
REPLICATE_API_TOKEN=your_token_here

# ElevenLabs (voice for RHYTHMIX narration)
ELEVENLABS_API_KEY=your_key_here

# Higgsfield AI (advanced image-to-video for RHYTHMIX)
HIGGSFIELD_API_KEY=your_key_here
HIGGSFIELD_SECRET=your_secret_here

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
