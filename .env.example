# StepFun Step 3.7 Flash — script & story generation MCP server.
# Get key at https://platform.stepfun.ai (Global) or https://platform.stepfun.com (China).
# Global: STEP_BASE_URL=https://api.stepfun.ai/v1
# China:  STEP_BASE_URL=https://api.stepfun.com/v1
STEP_API_KEY=your-stepfun-api-key-here
STEP_BASE_URL=https://api.stepfun.ai/v1

# Higgsfield AI MCP server credentials.
# Copy this file to `.env` (gitignored) and replace the values.
# Get keys from https://platform.higgsfield.ai
HIGGSFIELD_API_KEY=your-api-key-here
HIGGSFIELD_SECRET=your-secret-here

# Context7 MCP server (https://mcp.context7.com/mcp). Anonymous tier works
# without a key but is rate-limited. Free key at https://context7.com/dashboard.
CONTEXT7_API_KEY=your-api-key-here
