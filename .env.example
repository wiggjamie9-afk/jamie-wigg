# Root Project Environment Variables

# Creative AI Stack (Replicate + ElevenLabs)
REPLICATE_API_TOKEN=your-replicate-api-token
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Higgsfield AI (text-to-image, image-to-video)
HIGGSFIELD_API_KEY=your-higgsfield-api-key
HIGGSFIELD_SECRET=your-higgsfield-secret

# Step.fun Flash MCP (script generation)
STEP_API_KEY=your-step-api-key
STEP_BASE_URL=https://api.step.fun

# Context7 (library documentation)
CONTEXT7_API_KEY=your-context7-api-key

# OpenRouter (multi-LLM gateway) — free tier at https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Groq (ultra-fast inference) — free tier at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Firecrawl (web scraping and automation)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# MiniMax M3 (local or API) — default backend for the m3-think skill.
# Set MINIMAX_PROVIDER to minimax | openrouter | groq to change the default.
MINIMAX_PROVIDER=minimax
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3-text
MINIMAX_REASONING=adaptive

# GitHub (optional)
GITHUB_TOKEN=your-github-token

# Development
DEBUG=false
NODE_ENV=development
