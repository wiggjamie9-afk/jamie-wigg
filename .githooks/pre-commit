#!/bin/bash
# Blocks commits that contain live-looking API keys / credentials.
# Enable once with:  git config core.hooksPath .githooks
# Bypass a specific commit (rarely needed):  git commit --no-verify
#
# Patterns target REAL key formats and deliberately ignore the common
# documentation placeholders (EXAMPLE, XXXX, your-…, sk-... ellipses) so the
# repo's security-skill docs don't trip it.

set -u
fail=0

# Only look at what is actually staged.
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

# pattern~human label — '~' is the field separator (never appears in a regex
# below). The private-key regex avoids inner alternation so it can't collide
# with the separator.
patterns=(
  'sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20,}~Anthropic API key'
  'sk-proj-[A-Za-z0-9_-]{40,}~OpenAI project key'
  'sk-[A-Za-z0-9]{40,}~OpenAI/legacy secret key'
  'ghp_[A-Za-z0-9]{36}~GitHub personal access token'
  'gho_[A-Za-z0-9]{36}~GitHub OAuth token'
  'github_pat_[A-Za-z0-9_]{60,}~GitHub fine-grained PAT'
  'xox[baprs]-[0-9]{10,}-[A-Za-z0-9-]{20,}~Slack token'
  'AIza[0-9A-Za-z_-]{35}~Google API key'
  'AKIA[0-9A-Z]{16}~AWS access key ID'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----~Private key block'
)

for f in $files; do
  # skip binary and this hook itself
  case "$f" in .githooks/pre-commit) continue;; esac
  git show ":$f" 2>/dev/null | grep -qI . || continue   # skip binary
  added=$(git show ":$f" 2>/dev/null)
  for entry in "${patterns[@]}"; do
    re="${entry%%~*}"; label="${entry##*~}"
    # ignore obvious placeholders
    hits=$(printf '%s\n' "$added" | grep -nE -- "$re" | grep -viE 'EXAMPLE|XXXX+|your-|placeholder|redacted|\.\.\.' )
    if [ -n "$hits" ]; then
      echo "🚫 pre-commit: possible $label in $f:"
      printf '%s\n' "$hits" | sed 's/^/     /'
      fail=1
    fi
  done
done

if [ "$fail" = 1 ]; then
  echo
  echo "Commit blocked. If this is a real secret: remove it, rotate the key, and use an env var instead."
  echo "If it is a false positive: git commit --no-verify"
  exit 1
fi
exit 0
