{
  "name": "jamie-wigg",
  "version": "0.1.0",
  "private": true,
  "description": "Universal build ecosystem: web, backend, data science, AI agents, mobile, desktop, CLI tools, and infrastructure.",
  "type": "module",
  "scripts": {
    "setup": "pnpm install && pnpm run build:all",
    "dev": "pnpm --recursive run dev",
    "build": "pnpm --recursive run build",
    "build:all": "pnpm install && pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "test:watch": "pnpm --recursive run test:watch",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "pnpm --recursive run type-check",
    "clean": "pnpm --recursive exec rm -rf dist build .next out",
    "cli": "node packages/cli/dist/index.js",
    "new": "node packages/cli/dist/commands/new.js",
    "gen": "node packages/cli/dist/commands/gen.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "claude-playwright": "^0.1.4",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.9.0"
    }
  }
}
