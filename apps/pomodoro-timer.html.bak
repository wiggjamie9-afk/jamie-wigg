<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Focus Timer – Pomodoro Technique</title>
    <style>
        :root { --primary: #8B5CF6; --bg: #0F172A; --light: #1E293B; --text: #F1F5F9; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, sans-serif; background: var(--bg); color: var(--text); }
        .container { max-width: 480px; margin: 0 auto; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 20px; }
        .timer-display { font-size: 72px; font-weight: 700; color: var(--primary); text-align: center; margin-bottom: 24px; font-family: monospace; }
        .buttons { display: flex; gap: 12px; justify-content: center; margin-bottom: 24px; width: 100%; max-width: 300px; }
        button { padding: 12px 24px; border: none; border-radius: 8px; background: var(--primary); color: white; font-weight: 600; cursor: pointer; flex: 1; }
        button:hover { background: #7C3AED; }
        .session-info { text-align: center; font-size: 14px; color: #CBD5E1; margin-bottom: 32px; }
        .preset { background: var(--light); padding: 12px; border-radius: 8px; margin: 8px 0; cursor: pointer; border: 2px solid transparent; }
        .preset:hover { border-color: var(--primary); }
        .presets { width: 100%; max-width: 300px; }
    </style>
</head>
<body>
    <div class="container">
        <div style="text-align: center; margin-bottom: 40px;">
            <h1 style="font-size: 28px; margin-bottom: 4px;">⏱️ FOCUS TIMER</h1>
            <p style="font-size: 12px; color: #CBD5E1;">Pomodoro Technique</p>
        </div>

        <div class="timer-display" id="timer">25:00</div>
        <div class="session-info" id="session">Work Session</div>

        <div class="buttons">
            <button onclick="startTimer()">Start</button>
            <button onclick="pauseTimer()">Pause</button>
            <button onclick="resetTimer()">Reset</button>
        </div>

        <div class="presets">
            <div class="preset" onclick="setTimer(25, 'Work')">Work (25 min)</div>
            <div class="preset" onclick="setTimer(5, 'Break')">Short Break (5 min)</div>
            <div class="preset" onclick="setTimer(15, 'Long Break')">Long Break (15 min)</div>
            <div class="preset" onclick="setTimer(45, 'Deep Work')">Deep Work (45 min)</div>
        </div>
    </div>

    <script>
        let timeLeft = 1500;
        let isRunning = false;
        let timerInterval;
        let currentSession = 'Work';

        function updateDisplay() {
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            document.getElementById('timer').textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
        }

        function startTimer() {
            if (isRunning) return;
            isRunning = true;
            timerInterval = setInterval(() => {
                timeLeft--;
                updateDisplay();
                if (timeLeft === 0) {
                    clearInterval(timerInterval);
                    isRunning = false;
                    alert(`${currentSession} session complete!`);
                }
            }, 1000);
        }

        function pauseTimer() {
            clearInterval(timerInterval);
            isRunning = false;
        }

        function resetTimer() {
            clearInterval(timerInterval);
            isRunning = false;
            timeLeft = 1500;
            updateDisplay();
        }

        function setTimer(mins, session) {
            clearInterval(timerInterval);
            isRunning = false;
            timeLeft = mins * 60;
            currentSession = session;
            document.getElementById('session').textContent = `${session} Session`;
            updateDisplay();
        }

        updateDisplay();
    </script>
</body>
</html>
