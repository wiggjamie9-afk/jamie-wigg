{
  "name": "store-template-codementor",
  "version": "0.1.0",
  "private": true,
  "description": "Productionized Pro-app template: PWA + Claude proxy + Capacitor wrapper. Worked example: CodeMentor.",
  "scripts": {
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1 --directory app",
    "icons": "node scripts/gen-icons.mjs",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  }
}
