# OpenManus Notification Configuration Example
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to git - it contains sensitive passwords!

# Email Configuration
EMAIL_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password

# Slack Configuration (Optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# How to set up:
# 1. Gmail app password: https://myaccount.google.com/apppasswords
# 2. Slack webhook: https://api.slack.com/apps (Create App -> Incoming Webhooks)
# 3. Copy this file to .env: cp .env.example .env
# 4. Fill in your credentials in .env
# 5. Never commit .env - it's gitignored for security
