{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Copy this file to .claude/settings.local.json and fill in your tokens. settings.local.json is gitignored — never committed.",
  "env": {
    "REPLICATE_API_TOKEN": "r8_REPLACE_WITH_YOUR_TOKEN",
    "ELEVENLABS_API_KEY": "sk_REPLACE_WITH_YOUR_KEY",
    "CREATIVE_OUT_DIR": "./creative-out",

    "_supabase_mcp": "Personal access token from https://supabase.com/dashboard/account/tokens — read-only Project + Org scopes are enough for most ops.",
    "SUPABASE_ACCESS_TOKEN": "sbp_REPLACE_WITH_YOUR_TOKEN",
    "SUPABASE_PROJECT_REF": "REPLACE_WITH_YOUR_PROJECT_REF",

    "_stripe_mcp": "Restricted key with permission to manage products/prices and read PaymentIntents.",
    "STRIPE_SECRET_KEY": "rk_REPLACE_WITH_YOUR_RESTRICTED_KEY"
  }
}
