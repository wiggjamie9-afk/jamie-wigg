{
  "permissions": {
    "bash": {
      "allow": [
        "git",
        "npm",
        "pnpm",
        "node",
        "curl",
        "ls",
        "find",
        "grep",
        "cat",
        "echo",
        "mkdir",
        "rm",
        "cp",
        "mv",
        "cd",
        "pwd",
        "which",
        "command",
        "chmod",
        "chown"
      ]
    },
    "mcp": {
      "allowed_servers": [
        "creative-stack",
        "higgsfield",
        "pollinations",
        "playwright",
        "claude-playwright",
        "context7"
      ]
    }
  },
  "hooks": {
    "session-start": ".claude/hooks/session-start.sh",
    "on-tool-block": "echo 'Tool blocked: check .claude/settings.json permissions'"
  },
  "environment": {
    "NODE_ENV": "development",
    "DEBUG": "false"
  }
}
