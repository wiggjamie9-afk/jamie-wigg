      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git ls-files:*)",
      "Bash(git config --get:*)",

      "Bash(node:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npm view:*)",
      "Bash(npm ping)",
      "Bash(npm config get:*)",
      "Bash(npx --yes hyperframes:*)",
      "Bash(npx --yes hyperframes@0.4.42:*)",

      "Bash(python3 -c:*)",
      "Bash(python3 -m pip install:*)",
      "Bash(pip3 install:*)",

      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",

      "Bash(curl -sIL:*)",
      "Bash(curl -sI:*)",
      "Bash(curl -s:*)",
      "Bash(curl -fsSL:*)",
      "Bash(curl -sL:*)",
      "Bash(curl -fsS:*)",

      "Bash(mkdir -p:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm /tmp/:*)",
      "Bash(touch:*)",
      "Bash(ln -sf:*)",
      "Bash(chmod +x:*)",

      "Bash(.claude/hooks/session-start.sh:*)",

      "Read(//home/user/jamie-wigg/**)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh || true"
          }
        ]
      }
    ]
  }
