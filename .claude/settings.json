{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "F=\"$CLAUDE_PROJECT_DIR/.claude/notes.md\"; [ -s \"$F\" ] && jq -Rs '{hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:.}}' < \"$F\" || true"
          }
        ]
      }
    ]
  }
}
