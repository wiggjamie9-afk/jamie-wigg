{
  "permissions": {
    "bash": {
      "allow": [
        "git",
        "npm",
        "pnpm",
        "node",
        "curl",
        "ls",
        "find",
        "grep",
        "cat",
        "echo",
        "mkdir",
        "rm",
        "cp",
        "mv",
        "cd",
        "pwd",
        "which",
        "command",
        "chmod",
        "chown"
      ]
    },
    "mcp": {
      "allowed_servers": [
        "creative-stack",
        "higgsfield",
        "pollinations",
        "playwright",
        "claude-playwright",
        "context7"
      ]
    },
    "allow": [
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__*"
    ]
  },
  "hooks": {
    "session-start": ".claude/hooks/session-start.sh",
    "on-tool-block": "echo 'Tool blocked: check .claude/settings.json permissions'"
  },
  "environment": {
    "NODE_ENV": "development",
    "DEBUG": "false"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  }
}