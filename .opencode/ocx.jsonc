{
  "$schema": "https://ocx.kdco.dev/schemas/ocx.json",
  "registries": {
    // Kortix Registry — AI agent capabilities (skills, tools, plugins, agents)
    // for the Kortix sandbox platform. Installed via OCX.
    //   ocx add kortix/sandbox      (full sandbox bundle)
    //   ocx add kortix/deep-research kortix/web-search   (individual components)
    //
    // NOTE: registry.kortix.ai is blocked by this sandbox's egress policy, so
    // `ocx add kortix/...` only resolves on a machine with open egress (or once
    // the host is allowlisted). The config below is pre-wired and ready.
    "kortix": {
      "url": "https://registry.kortix.ai"
    }
  },
  "lockRegistries": false,
  "skipCompatCheck": false
}
