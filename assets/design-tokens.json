{
  "$schema": "Three-layer design tokens: primitive -> semantic -> component. Source of truth for the RHYTHMIX brand.",
  "primitive": {
    "color": {
      "ink": {
        "950": "#0A0A14",
        "900": "#13131F",
        "800": "#1B1B2C",
        "700": "#2A2A48",
        "500": "#6B6B85",
        "300": "#A8A8C0",
        "100": "#F5F5FA"
      },
      "red": {
        "500": "#FF1F5A",
        "600": "#E51852",
        "100": "#FFE5EC"
      },
      "purple": {
        "500": "#7C3AED",
        "600": "#6D28D9",
        "100": "#EDE9FE"
      },
      "gold": {
        "500": "#F5C000",
        "100": "#FEF3C7"
      },
      "green": {
        "500": "#22C55E"
      }
    },
    "spacing": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "14px",
      "xl": "18px",
      "pill": "100px"
    },
    "fontFamily": {
      "heading": "'Space Grotesk', 'Inter', system-ui, sans-serif",
      "body": "'Inter', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'SF Mono', Menlo, monospace"
    },
    "fontSize": {
      "xs": "11px",
      "sm": "12px",
      "base": "14px",
      "md": "15px",
      "lg": "17px",
      "xl": "20px",
      "2xl": "26px",
      "3xl": "32px",
      "4xl": "44px",
      "5xl": "52px",
      "6xl": "76px"
    },
    "shadow": {
      "card": "0 8px 24px rgba(0, 0, 0, 0.25)",
      "cta": "0 8px 22px rgba(255, 31, 90, 0.4)",
      "glow": "0 0 40px rgba(124, 58, 237, 0.25)"
    },
    "duration": {
      "fast": "150ms",
      "base": "200ms",
      "slow": "300ms"
    },
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  },
  "semantic": {
    "color": {
      "background": "{primitive.color.ink.950}",
      "surface": "{primitive.color.ink.900}",
      "surface-alt": "{primitive.color.ink.800}",
      "border": "{primitive.color.ink.700}",
      "text": "{primitive.color.ink.100}",
      "text-soft": "{primitive.color.ink.300}",
      "text-muted": "{primitive.color.ink.500}",
      "primary": "{primitive.color.red.500}",
      "primary-strong": "{primitive.color.red.600}",
      "secondary": "{primitive.color.purple.500}",
      "premium": "{primitive.color.gold.500}",
      "success": "{primitive.color.green.500}"
    },
    "gradient": {
      "brand": "linear-gradient(135deg, #FF1F5A, #7C3AED)",
      "premium": "linear-gradient(135deg, rgba(245,192,0,0.08), rgba(255,31,90,0.06))",
      "card-popular": "linear-gradient(135deg, rgba(255,31,90,0.06), rgba(124,58,237,0.06))"
    }
  },
  "component": {
    "button": {
      "primary": {
        "background": "{semantic.gradient.brand}",
        "color": "#FFFFFF",
        "padding": "12px 24px",
        "radius": "{primitive.radius.sm}",
        "fontSize": "{primitive.fontSize.base}",
        "shadow-hover": "{primitive.shadow.cta}"
      },
      "outline": {
        "background": "transparent",
        "color": "{semantic.color.text-soft}",
        "border": "1px solid {primitive.color.ink.700}"
      }
    },
    "card": {
      "background": "{semantic.color.surface}",
      "border": "1px solid {semantic.color.border}",
      "radius": "{primitive.radius.lg}",
      "padding": "{primitive.spacing.6}"
    },
    "badge": {
      "fontSize": "{primitive.fontSize.xs}",
      "letterSpacing": "2px",
      "padding": "3px 10px",
      "radius": "{primitive.radius.pill}",
      "fontFamily": "{primitive.fontFamily.mono}"
    },
    "hero": {
      "title-fontSize": "clamp(38px, 7vw, 76px)",
      "title-letterSpacing": "-2px",
      "title-lineHeight": "0.95"
    }
  }
}
