# Copy this file to .env and fill in your values. Never commit .env to git.
#
# After copying:
#   cp .env.example .env
#
# Then add the real values below. The .env file is gitignored.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Find these in your Supabase project at:
#   https://supabase.com/dashboard/project/<your-project>/settings/api

# Your Supabase project URL (e.g. https://abcdefghijklmnop.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose in the browser bundle.
# Used by the React app to authenticate users and query data via RLS.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SECRET. Never expose this in client-side code.
# Used only by the Vercel serverless function (api/send-reminders.ts) to
# bypass RLS when querying across orgs for the daily reminder job.
# Keep this out of any frontend build step.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Create a free account at https://resend.com and generate an API key from
# https://resend.com/api-keys
# Used by api/send-reminders.ts to send volunteer reminder emails.
RESEND_API_KEY=re_...

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# Find these in your Stripe dashboard at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) during development; switch to live keys for production.

# Secret key — server-side only. Used by api/create-checkout.ts to create
# Stripe Checkout sessions for the $12/month Chapel Pro upgrade flow.
STRIPE_SECRET_KEY=sk_test_...

# The Price ID for the $12/month Chapel Pro subscription.
# Create a Product + recurring Price in your Stripe dashboard, then copy the
# price ID (starts with price_) from the price details page.
# Example: price_1OabcDEFghIJKlMN0pQRsTUv
STRIPE_PRICE_ID=price_...

# ─── Security ────────────────────────────────────────────────────────────────
# A random secret used to authenticate the /api/send-reminders cron endpoint.
# Vercel Cron sends this value in the Authorization header; the function
# rejects any request that doesn't match.
#
# Generate a strong secret with:
#   openssl rand -hex 32
#
# Set the same value here AND in your Vercel project environment variables.
CRON_SECRET=your-random-hex-secret-here

# ─── App URL ─────────────────────────────────────────────────────────────────
# The public URL of your deployed app.
# Used to build absolute URLs for Stripe Checkout success/cancel redirects.
# In development you can use http://localhost:5173
# In production use your Vercel deployment URL, e.g. https://chapel.vercel.app
VITE_APP_URL=https://chapel.vercel.app
