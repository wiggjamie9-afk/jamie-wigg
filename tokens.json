{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": { "value": "{{BRAND_NAME}}", "type": "string" },
    "industry": { "value": "Film & Entertainment Production", "type": "string" },
    "vibe": { "value": "Cinematic, premium, dramatic, timeless", "type": "string" }
  },
  "color": {
    "primary": {
      "900": { "value": "#0A0A0B", "type": "color" },
      "700": { "value": "#1A1A1D", "type": "color" },
      "500": { "value": "#2E2E33", "type": "color" },
      "300": { "value": "#5C5C66", "type": "color" },
      "100": { "value": "#B8B8C2", "type": "color" }
    },
    "secondary": {
      "700": { "value": "#8C6E1F", "type": "color" },
      "500": { "value": "#C9A14A", "type": "color" },
      "300": { "value": "#E3C681", "type": "color" },
      "100": { "value": "#F4E6BF", "type": "color" }
    },
    "accent": {
      "700": { "value": "#7A1F1F", "type": "color" },
      "500": { "value": "#B23A3A", "type": "color" },
      "300": { "value": "#D87878", "type": "color" }
    },
    "neutral": {
      "0":   { "value": "#FFFFFF", "type": "color" },
      "50":  { "value": "#F5F2EC", "type": "color" },
      "100": { "value": "#EAE6DC", "type": "color" },
      "200": { "value": "#D6D1C4", "type": "color" },
      "400": { "value": "#8E8A80", "type": "color" },
      "700": { "value": "#3A3833", "type": "color" },
      "900": { "value": "#14130F", "type": "color" }
    },
    "semantic": {
      "success": { "value": "#3A8A5C", "type": "color" },
      "warning": { "value": "#D89B2C", "type": "color" },
      "danger":  { "value": "#C0392B", "type": "color" },
      "info":    { "value": "#3B6FA8", "type": "color" }
    }
  },
  "typography": {
    "family": {
      "display": { "value": "'Playfair Display', 'Cormorant Garamond', Georgia, serif", "type": "fontFamily" },
      "body":    { "value": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif", "type": "fontFamily" },
      "mono":    { "value": "'JetBrains Mono', 'IBM Plex Mono', Menlo, monospace", "type": "fontFamily" }
    },
    "weight": {
      "regular":  { "value": 400, "type": "fontWeight" },
      "medium":   { "value": 500, "type": "fontWeight" },
      "semibold": { "value": 600, "type": "fontWeight" },
      "bold":     { "value": 700, "type": "fontWeight" },
      "extrabold":{ "value": 800, "type": "fontWeight" },
      "black":    { "value": 900, "type": "fontWeight" }
    },
    "scale": {
      "displayXl": { "size": "72px", "lineHeight": 1.05, "weight": 900 },
      "displayLg": { "size": "56px", "lineHeight": 1.08, "weight": 800 },
      "displayMd": { "size": "40px", "lineHeight": 1.15, "weight": 700 },
      "h1":        { "size": "32px", "lineHeight": 1.2,  "weight": 700 },
      "h2":        { "size": "24px", "lineHeight": 1.3,  "weight": 600 },
      "h3":        { "size": "20px", "lineHeight": 1.35, "weight": 600 },
      "bodyLg":    { "size": "18px", "lineHeight": 1.6,  "weight": 400 },
      "body":      { "size": "16px", "lineHeight": 1.6,  "weight": 400 },
      "bodySm":    { "size": "14px", "lineHeight": 1.55, "weight": 400 },
      "mono":      { "size": "13px", "lineHeight": 1.5,  "weight": 500 },
      "overline":  { "size": "12px", "lineHeight": 1.4,  "weight": 600, "letterSpacing": "0.12em", "case": "uppercase" }
    }
  },
  "space": {
    "0":  { "value": "0px",   "type": "dimension" },
    "1":  { "value": "4px",   "type": "dimension" },
    "2":  { "value": "8px",   "type": "dimension" },
    "3":  { "value": "12px",  "type": "dimension" },
    "4":  { "value": "16px",  "type": "dimension" },
    "6":  { "value": "24px",  "type": "dimension" },
    "8":  { "value": "32px",  "type": "dimension" },
    "12": { "value": "48px",  "type": "dimension" },
    "16": { "value": "64px",  "type": "dimension" },
    "24": { "value": "96px",  "type": "dimension" },
    "32": { "value": "128px", "type": "dimension" }
  },
  "radius": {
    "sm":   { "value": "2px",    "type": "dimension" },
    "md":   { "value": "6px",    "type": "dimension" },
    "lg":   { "value": "12px",   "type": "dimension" },
    "pill": { "value": "9999px", "type": "dimension" }
  },
  "shadow": {
    "sm": { "value": "0 1px 2px rgba(10,10,11,0.24)" },
    "md": { "value": "0 6px 16px rgba(10,10,11,0.32)" },
    "lg": { "value": "0 24px 48px rgba(10,10,11,0.40)" }
  },
  "motion": {
    "ease": { "cinema": { "value": "cubic-bezier(0.2, 0.7, 0.1, 1)" } },
    "duration": {
      "fast": { "value": "120ms" },
      "base": { "value": "220ms" },
      "slow": { "value": "480ms" }
    }
  },
  "breakpoint": {
    "sm":  { "value": "640px"  },
    "md":  { "value": "768px"  },
    "lg":  { "value": "1024px" },
    "xl":  { "value": "1280px" },
    "2xl": { "value": "1536px" }
  },
  "container": {
    "max":   { "value": "1280px" },
    "prose": { "value": "720px"  }
  }
}
