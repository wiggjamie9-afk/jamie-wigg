{
  "name": "reset-recovery-ios",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor wrapper around /recovery/ for iPhone distribution (TestFlight / App Store).",
  "scripts": {
    "sync:web": "rm -rf www && cp -r ../recovery www && npx cap sync ios",
    "add:ios": "npx cap add ios",
    "open:ios": "npx cap open ios",
    "build:ios": "npm run sync:web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/network": "^6.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
