#!/bin/bash
# Aider AI launcher - activates virtual environment and runs Aider

set -e

# Get the directory this script is in
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Paths
AIDER_ENV="$HOME/.aider-env"
AIDER_BIN="$AIDER_ENV/bin/aider"

# Check if venv exists
if [ ! -d "$AIDER_ENV" ]; then
    echo "❌ Aider environment not found at $AIDER_ENV"
    echo ""
    echo "Setting up Aider AI..."
    python3 -m venv "$AIDER_ENV"
    source "$AIDER_ENV/bin/activate"
    pip install --upgrade pip
    pip install git+https://github.com/Aider-AI/aider.git
    echo "✅ Aider AI installed successfully!"
    echo ""
fi

# Activate venv and run aider
source "$AIDER_ENV/bin/activate"
exec aider "$@"
