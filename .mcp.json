{
  "mcpServers": {
    "stepfun": {
      "command": "node",
      "args": [".claude/mcp/stepfun/server.mjs"],
      "env": {
        "STEP_API_KEY": "${STEP_API_KEY}",
        "STEP_BASE_URL": "${STEP_BASE_URL}"
      }
    },
    "creative-stack": {
      "command": "node",
      "args": [".claude/mcp/creative-stack/server.mjs"]
    },
    "zyloo": {
      "command": "node",
      "args": [".claude/mcp/zyloo/server.mjs"],
      "env": {
        "ZYLOO_API_KEY": "${ZYLOO_API_KEY}",
        "ZYLOO_BASE_URL": "${ZYLOO_BASE_URL}",
        "ZYLOO_MODEL": "${ZYLOO_MODEL}"
      }
    },
    "higgsfield": {
      "command": "higgsfield-mcp",
      "env": {
        "HIGGSFIELD_API_KEY": "${HIGGSFIELD_API_KEY}",
        "HIGGSFIELD_SECRET": "${HIGGSFIELD_SECRET}"
      }
    },
    "pollinations": {
      "command": "npx",
      "args": ["-y", "@pollinations/model-context-protocol"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "claude-playwright": {
      "command": "node",
      "args": ["node_modules/claude-playwright/dist/mcp/server.cjs"],
      "env": {
        "BASE_URL": "http://localhost:8000"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}
