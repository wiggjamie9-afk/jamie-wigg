{
  "mcpServers": {
    "creative-stack": {
      "command": "node",
      "args": [".claude/mcp/creative-stack/server.mjs"]
    },
    "higgsfield": {
      "command": "higgsfield-mcp",
      "env": {
        "HIGGSFIELD_API_KEY": "${HIGGSFIELD_API_KEY}",
        "HIGGSFIELD_SECRET": "${HIGGSFIELD_SECRET}"
      }
    },
    "pollinations": {
      "command": "npx",
      "args": ["-y", "@pollinations/model-context-protocol"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "excel": {
      "command": "uvx",
      "args": ["excel-mcp-server", "stdio"],
      "env": {
        "EXCEL_FILES_PATH": "${EXCEL_FILES_PATH:-./}"
      }
    },
    "perplexity": {
      "command": "npx",
      "args": ["-yq", "@perplexity-ai/mcp-server"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "openspace": {
      "command": "/home/user/jamie-wigg/external/OpenSpace/.venv/bin/openspace-mcp",
      "toolTimeout": 600,
      "env": {
        "OPENSPACE_HOST_SKILL_DIRS": "/home/user/jamie-wigg/.claude/skills",
        "OPENSPACE_WORKSPACE": "/home/user/jamie-wigg/external/OpenSpace",
        "OPENSPACE_API_KEY": "${OPENSPACE_API_KEY}"
      }
    }
  }
}
