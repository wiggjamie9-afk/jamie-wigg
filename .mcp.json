{
  "mcpServers": {
    "stepfun": {
      "command": "node",
      "args": [".claude/mcp/stepfun/server.mjs"],
      "env": {
        "STEP_API_KEY": "${STEP_API_KEY}",
        "STEP_BASE_URL": "${STEP_BASE_URL}"
      }
    },
    "creative-stack": {
      "command": "node",
      "args": [".claude/mcp/creative-stack/server.mjs"]
    },
    "higgsfield": {
      "command": "higgsfield-mcp",
      "env": {
        "HIGGSFIELD_API_KEY": "${HIGGSFIELD_API_KEY}",
        "HIGGSFIELD_SECRET": "${HIGGSFIELD_SECRET}"
      }
    },
    "pollinations": {
      "command": "npx",
      "args": ["-y", "@pollinations/model-context-protocol"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "claude-playwright": {
      "command": "node",
      "args": ["node_modules/claude-playwright/dist/mcp/server.cjs"],
      "env": {
        "BASE_URL": "http://localhost:8000"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "zapier": {
      "url": "https://mcp.zapier.com/mcp/servers"
    },
    "minimax": {
      "command": "node",
      "args": [".claude/mcp/minimax/server.mjs"],
      "env": {
        "MINIMAX_PROVIDER": "${MINIMAX_PROVIDER}",
        "MINIMAX_API_KEY": "${MINIMAX_API_KEY}",
        "MINIMAX_API_BASE": "${MINIMAX_API_BASE}",
        "MINIMAX_MODEL": "${MINIMAX_MODEL}",
        "MINIMAX_REASONING": "${MINIMAX_REASONING}",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
        "OPENROUTER_BASE_URL": "${OPENROUTER_BASE_URL}",
        "OPENROUTER_MODEL": "${OPENROUTER_MODEL}",
        "GROQ_API_KEY": "${GROQ_API_KEY}",
        "GROQ_API_BASE": "${GROQ_API_BASE}",
        "GROQ_MODEL": "${GROQ_MODEL}"
      }
    }
  }
}
