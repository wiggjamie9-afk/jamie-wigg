{
  "mcpServers": {
    "stepfun": {
      "command": "node",
      "args": [".claude/mcp/stepfun/server.mjs"],
      "env": {
        "STEP_API_KEY": "${STEP_API_KEY}",
        "STEP_BASE_URL": "${STEP_BASE_URL}"
      }
    },
    "creative-stack": {
      "command": "node",
      "args": [".claude/mcp/creative-stack/server.mjs"]
    },
    "higgsfield": {
      "command": "higgsfield-mcp",
      "env": {
        "HIGGSFIELD_API_KEY": "${HIGGSFIELD_API_KEY}",
        "HIGGSFIELD_SECRET": "${HIGGSFIELD_SECRET}"
      }
    },
    "pollinations": {
      "command": "npx",
      "args": ["-y", "@pollinations/model-context-protocol"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "claude-playwright": {
      "command": "node",
      "args": ["node_modules/claude-playwright/dist/mcp/server.cjs"],
      "env": {
        "BASE_URL": "http://localhost:8000"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "lmstudio-mcp": {
      "command": "uvx",
      "args": ["https://github.com/infinitimeless/LMStudio-MCP"],
      "description": "Local LLM bridge via LM Studio. Use for private/offline inference, embeddings, and multi-turn conversations. start_conversation and continue_conversation require LM Studio v0.3.29+."
    }
  }
}
