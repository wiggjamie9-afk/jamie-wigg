# Stock Recommendation Platform - Environment Variables

# Polygon API Configuration
# Get your API key from: https://polygon.io/
POLYGON_API_KEY=your_polygon_api_key_here

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Analysis Configuration
DEFAULT_ANALYSIS_PERIOD=30
MIN_ANALYSIS_PERIOD=5
MAX_ANALYSIS_PERIOD=252

# Recommendation Thresholds
STRONG_BUY_THRESHOLD=0.80
BUY_THRESHOLD=0.65
SELL_THRESHOLD=0.35
STRONG_SELL_THRESHOLD=0.20

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=300

# Portfolio Configuration
MAX_BATCH_SYMBOLS=50

# Logging
LOG_LEVEL=INFO
