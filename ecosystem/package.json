{
  "name": "jacksons-ecosystem",
  "version": "1.0.0",
  "description": "Unified video-to-text-to-voice-to-music production pipeline. Fully activated, no external purchases.",
  "type": "module",
  "main": "jackson.js",
  "bin": {
    "jackson": "jackson.js"
  },
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "cli": "node jackson.js",
    "help": "node jackson.js help",
    "demo": "node jackson.js text-to-voice-music 'Create a motivational video about AI transforming healthcare' --enhance",
    "web": "python3 -m http.server 8000 --bind 127.0.0.1 --directory .",
    "text-to-voice": "node jackson.js text-to-voice",
    "text-to-music": "node jackson.js text-to-music",
    "video-to-text": "node jackson.js video-to-text"
  },
  "keywords": [
    "video",
    "text-to-speech",
    "music-generation",
    "voice",
    "replicate",
    "claude",
    "elevenlabs",
    "kokoro",
    "hyperframes"
  ],
