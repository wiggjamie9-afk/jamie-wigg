# ask.py Ollama Configuration
# Local LLM inference and embeddings — zero API cost

# Ollama inference endpoint (local)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=dummy-key
DEFAULT_INFERENCE_MODEL=gemma-2

# Ollama embeddings (same endpoint)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Search (required for web search mode; can be empty for local-only mode)
# Get keys from https://programmablesearchengine.google.com/
SEARCH_API_KEY=
SEARCH_PROJECT_KEY=

# UI
SHARE_GRADIO_UI=false

# Logging
LOG_LEVEL=INFO
