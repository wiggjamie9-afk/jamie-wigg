{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythmixapp.com.au/schemas/skills-index.v1.schema.json",
  "title": "Stable Skills Manifest v1 (skills-gtm)",
  "description": "Discovery manifest for the SKILLS-GTM go-to-market prompt library. A host reads the `skills` array and loads a skill's `path` only when its `id` is requested.",
  "type": "object",
  "required": ["manifestVersion", "name", "skills"],
  "additionalProperties": true,
  "properties": {
    "manifestVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "license": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["id", "path", "metadata"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable, unique skill identifier used by hosts to request the skill (e.g. @gtm-roles-sdr-bdr-cold-outreach)."
        },
        "name": { "type": "string" },
        "path": {
          "type": "string",
          "pattern": "\\.md$",
          "description": "Repo-relative path to the skill's markdown file."
        },
        "category": { "type": "string" },
        "metadata": {
          "type": "object",
          "required": ["domain", "group", "risk"],
          "additionalProperties": true,
          "properties": {
            "domain": { "type": "string" },
            "group": {
              "type": "string",
              "enum": ["roles", "industries", "methodologies", "workflows"]
            },
            "subcategory": { "type": "string" },
            "risk": {
              "type": "string",
              "enum": ["none", "safe", "low", "medium", "high"]
            },
            "license": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}
