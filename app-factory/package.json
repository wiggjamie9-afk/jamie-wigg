{
  "name": "app-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App Factory — packages batches of standalone HTML apps into native iOS + Android shells via Capacitor.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "cap sync",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "build": "npm run build:web && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "serve": "node -e \"import('node:http').then(h=>import('node:fs').then(f=>h.createServer((q,r)=>{let p='./www'+(q.url==='/'?'/index.html':q.url.split('?')[0]);try{r.end(f.readFileSync(p))}catch{r.statusCode=404;r.end('404')}}).listen(8000,()=>console.log('http://localhost:8000'))))\""
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0"
  }
}
