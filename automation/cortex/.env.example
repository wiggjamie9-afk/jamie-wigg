# RHYTHMIX × Cortex — environment.
# Copy to .env in this folder and fill in what you need:  cp .env.example .env
# The factory runs with NOTHING but Ollama set. Everything else is optional and
# only enables the matching tool.

# ── The brain (planner). Free + legal + offline. This is all you need to boot. ──
# Install: curl -fsSL https://ollama.com/install.sh | sh && ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Optional: a paid, hosted planner as the QUALITY fallback in the model group ─
# Legitimate API keys only (NOT browser-session gateways — those break provider
# ToS and get accounts banned). Leave blank to stay 100% free/local.
# OPENAI_API_KEY=
# CLAUDE_API_KEY=

# ── Optional engine keys/paths (each enables one tool; leave blank to skip) ────
# Hosted image/video/audio (works with no GPU):
# MODELSLAB_API_KEY=
# Local talking-head video (needs a CUDA GPU):
# IDLORA_HOME=~/ID-LoRA
# IDLORA_LORA_PATH=~/ID-LoRA/models/id-lora-celebvhq-ltx2.3/lora_weights.safetensors
# Local fast stills (Z-Image MCP server):
# ZIMAGE_HOST=http://localhost:8001
# Local HiDream-O1 via ComfyUI (download the workflow template JSON):
# COMFYUI_SERVER=127.0.0.1:8188
# HIDREAM_TEMPLATE=/path/to/image_hidream_o1.json
# On-device transcription (whisper.cpp build + ggml model):
# WHISPER_BIN=~/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=~/whisper.cpp/models/ggml-base.en.bin
# Vision / asset QA (local LLaVA server):
# LLAVA_URL=http://localhost:8080

# ── Server ────────────────────────────────────────────────────────────────────
CORTEX_PORT=4000
CORTEX_ENABLE_REST=true
