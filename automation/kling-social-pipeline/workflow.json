{
  "name": "RHYTHMIX Content Engine — Webhook → Kling 2.1 → Socials",
  "nodes": [
    {
      "parameters": {
        "content": "## Content Engine (webhook-driven)\nPOST a run to the webhook (from the agent-builder dashboard or any client):\n```\n{ \"run_id\": \"<uuid>\", \"topic\": \"...\", \"duration\": \"30s\", \"aspect\": \"portrait\", \"vibe\": \"jazz\" }\n```\nThe Google Sheet is the run-log + status store; the dashboard polls it by run_id.",
        "height": 260,
        "width": 560,
        "color": 4
      },
      "id": "note-intro",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-40, -200]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "content-engine",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook (dashboard)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 120],
      "webhookId": "rhythmix-content-engine"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "run_id", "value": "={{ $json.body.run_id }}", "type": "string" },
            { "id": "n2", "name": "topic", "value": "={{ $json.body.topic }}", "type": "string" },
            { "id": "n3", "name": "duration", "value": "={{ $json.body.duration || '30s' }}", "type": "string" },
            { "id": "n4", "name": "aspect", "value": "={{ $json.body.aspect || 'landscape' }}", "type": "string" },
            { "id": "n5", "name": "vibe", "value": "={{ $json.body.vibe || 'cinematic' }}", "type": "string" },
            { "id": "n6", "name": "submittedAt", "value": "={{ $now.toMillis() }}", "type": "number" }
          ]
        },
        "options": {}
      },
      "id": "normalize",
      "name": "Normalize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 120]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "YOUR_GOOGLE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Sheet1", "mode": "list", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $json.run_id }}",
            "topic": "={{ $json.topic }}",
            "duration": "={{ $json.duration }}",
            "aspect": "={{ $json.aspect }}",
            "vibe": "={{ $json.vibe }}",
            "status": "processing",
            "video_url": "",
            "created_at": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "append-row",
      "name": "Append Run Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 120],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" }
      }
    },

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-8\",\n  \"max_tokens\": 400,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You write vivid, camera-aware prompts for the Kling 2.1 text-to-video model. Return ONLY the prompt, one paragraph, no preamble. Topic: {{ $json.topic }}. Vibe: {{ $json.vibe }}. Aspect: {{ $json.aspect }}. Style: cinematic, beat-driven, RHYTHMIX neon aesthetic (deep near-black canvas, magenta #ff1f5a, cyan #00d8ff, electric green).\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "gen-prompt",
      "name": "Generate Kling Prompt (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 120],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_ME", "name": "Anthropic x-api-key" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "prompt", "value": "={{ $json.content[0].text }}", "type": "string" },
            { "id": "e2", "name": "run_id", "value": "={{ $('Normalize').item.json.run_id }}", "type": "string" },
            { "id": "e3", "name": "aspect", "value": "={{ $('Normalize').item.json.aspect }}", "type": "string" },
            { "id": "e4", "name": "submittedAt", "value": "={{ $('Normalize').item.json.submittedAt }}", "type": "number" }
          ]
        },
        "options": {}
      },
      "id": "extract-prompt",
      "name": "Extract Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.replicate.com/v1/predictions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "content-type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"REPLACE_WITH_KLING_2_1_MODEL_VERSION_HASH\",\n  \"input\": {\n    \"prompt\": {{ JSON.stringify($json.prompt) }},\n    \"duration\": 5,\n    \"aspect_ratio\": {{ $json.aspect === 'portrait' ? '\"9:16\"' : ($json.aspect === 'square' ? '\"1:1\"' : '\"16:9\"') }}\n  }\n}",
        "options": {}
      },
      "id": "submit-kling",
      "name": "Submit to Kling (Replicate)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 120],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_ME", "name": "Replicate Bearer token" }
      }
    },

    {
      "parameters": { "amount": 5, "unit": "seconds" },
      "id": "wait",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1320, 120],
      "webhookId": "content-engine-poll"
    },
    {
      "parameters": {
        "url": "={{ $('Submit to Kling (Replicate)').item.json.urls.get }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "check-status",
      "name": "Check Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 120],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_ME", "name": "Replicate Bearer token" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            { "id": "s1", "leftValue": "={{ $json.status }}", "rightValue": "succeeded", "operator": { "type": "string", "operation": "equals" } }
          ]
        },
        "options": {}
      },
      "id": "if-succeeded",
      "name": "Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1760, 120]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "or",
          "conditions": [
            { "id": "f1", "leftValue": "={{ $json.status }}", "rightValue": "failed", "operator": { "type": "string", "operation": "equals" } },
            { "id": "f2", "leftValue": "={{ $json.status }}", "rightValue": "canceled", "operator": { "type": "string", "operation": "equals" } }
          ]
        },
        "options": {}
      },
      "id": "if-failed",
      "name": "Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1980, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            { "id": "t1", "leftValue": "={{ $now.toMillis() - $('Extract Prompt').item.json.submittedAt }}", "rightValue": 600000, "operator": { "type": "number", "operation": "gt" } }
          ]
        },
        "options": {}
      },
      "id": "if-timeout",
      "name": "Timed out? (>10m)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2200, 460]
    },

    {
      "parameters": {
        "url": "={{ $('Check Status').item.json.output }}",
        "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "video" } } }
      },
      "id": "download",
      "name": "Download MP4",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 0]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "YOUR_GOOGLE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Sheet1", "mode": "list", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $('Extract Prompt').item.json.run_id }}",
            "status": "done",
            "video_url": "={{ $('Check Status').item.json.output }}"
          },
          "matchingColumns": [ "run_id" ]
        },
        "options": {}
      },
      "id": "row-done",
      "name": "Row: done",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2200, -120],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Extract Prompt').item.json.prompt.slice(0, 90) }}",
        "regionCode": "US",
        "categoryId": "22",
        "options": { "description": "={{ $('Extract Prompt').item.json.prompt }}", "privacyStatus": "private" }
      },
      "id": "youtube",
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [2420, -240],
      "credentials": { "youTubeOAuth2Api": { "id": "REPLACE_ME", "name": "YouTube account" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/video/init/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"post_info\": { \"title\": {{ JSON.stringify($('Extract Prompt').item.json.prompt.slice(0,150)) }}, \"privacy_level\": \"SELF_ONLY\" },\n  \"source_info\": { \"source\": \"PULL_FROM_URL\", \"video_url\": {{ JSON.stringify($('Check Status').item.json.output) }} }\n}",
        "options": {}
      },
      "id": "tiktok",
      "name": "Upload to TikTok",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, -60],
      "disabled": true,
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_ME", "name": "TikTok OAuth bearer" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $vars.IG_USER_ID }}/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "media_type", "value": "REELS" },
            { "name": "video_url", "value": "={{ $('Check Status').item.json.output }}" },
            { "name": "caption", "value": "={{ $('Extract Prompt').item.json.prompt.slice(0,200) }}" }
          ]
        },
        "options": {}
      },
      "id": "instagram",
      "name": "Upload to Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, 120],
      "disabled": true,
      "credentials": { "httpQueryAuth": { "id": "REPLACE_ME", "name": "Meta Graph access_token" } }
    },

    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "YOUR_GOOGLE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Sheet1", "mode": "list", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $('Extract Prompt').item.json.run_id }}",
            "status": "={{ $('Check Status').item.json.status }}",
            "video_url": "={{ $('Check Status').item.json.error || '' }}"
          },
          "matchingColumns": [ "run_id" ]
        },
        "options": {}
      },
      "id": "row-failed",
      "name": "Row: failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2200, 320],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "YOUR_GOOGLE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Sheet1", "mode": "list", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $('Extract Prompt').item.json.run_id }}",
            "status": "timeout",
            "video_url": ""
          },
          "matchingColumns": [ "run_id" ]
        },
        "options": {}
      },
      "id": "row-timeout",
      "name": "Row: timeout",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2420, 560],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    }
  ],
  "connections": {
    "Webhook (dashboard)": { "main": [ [ { "node": "Normalize", "type": "main", "index": 0 } ] ] },
    "Normalize": { "main": [ [ { "node": "Append Run Row", "type": "main", "index": 0 } ] ] },
    "Append Run Row": { "main": [ [ { "node": "Generate Kling Prompt (Claude)", "type": "main", "index": 0 } ] ] },
    "Generate Kling Prompt (Claude)": { "main": [ [ { "node": "Extract Prompt", "type": "main", "index": 0 } ] ] },
    "Extract Prompt": { "main": [ [ { "node": "Submit to Kling (Replicate)", "type": "main", "index": 0 } ] ] },
    "Submit to Kling (Replicate)": { "main": [ [ { "node": "Wait 5s", "type": "main", "index": 0 } ] ] },
    "Wait 5s": { "main": [ [ { "node": "Check Status", "type": "main", "index": 0 } ] ] },
    "Check Status": { "main": [ [ { "node": "Succeeded?", "type": "main", "index": 0 } ] ] },
    "Succeeded?": {
      "main": [
        [ { "node": "Download MP4", "type": "main", "index": 0 } ],
        [ { "node": "Failed?", "type": "main", "index": 0 } ]
      ]
    },
    "Download MP4": { "main": [ [ { "node": "Row: done", "type": "main", "index": 0 } ] ] },
    "Row: done": {
      "main": [ [
        { "node": "Upload to YouTube", "type": "main", "index": 0 },
        { "node": "Upload to TikTok", "type": "main", "index": 0 },
        { "node": "Upload to Instagram", "type": "main", "index": 0 }
      ] ]
    },
    "Failed?": {
      "main": [
        [ { "node": "Row: failed", "type": "main", "index": 0 } ],
        [ { "node": "Timed out? (>10m)", "type": "main", "index": 0 } ]
      ]
    },
    "Timed out? (>10m)": {
      "main": [
        [ { "node": "Row: timeout", "type": "main", "index": 0 } ],
        [ { "node": "Wait 5s", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templatecredsSetupCompleted": false }
}
