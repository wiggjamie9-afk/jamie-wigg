# Capacitor — local-only generated content
node_modules/
www/

# iOS — generated by `npx cap add ios`; commit if you want CI to skip
# the regen, otherwise let CI regenerate per build.
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/.DS_Store
ios/App/output/

# Android — only if you `cap add android` later.
android/app/build/
android/build/
android/.gradle/
android/local.properties

# Appflow CLI cache
.appflow/
