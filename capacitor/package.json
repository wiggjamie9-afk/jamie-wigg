{
  "name": "rhythmix-studio-ios",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor wrapper around studio/ for iPhone distribution via Appflow.",
  "scripts": {
    "build:web": "cd ../studio && pnpm install && pnpm build",
    "sync:web": "rm -rf www && cp -r ../studio/out www && npx cap sync",
    "build": "pnpm build:web && pnpm sync:web",
    "open:ios": "npx cap open ios",
    "add:ios": "npx cap add ios",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@ionic/cli": "^7.2.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
