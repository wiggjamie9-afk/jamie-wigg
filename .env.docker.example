# Neural Twin AIO Docker Compose Configuration
# Copy this to .env and fill in your values

# ANTHROPIC API Key (required)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL Password (will be auto-generated if not provided)
POSTGRES_PASSWORD=your-secure-password

# Optional: Custom environment
NODE_ENV=development
LOG_LEVEL=debug

# Note: JWT_SECRET and SESSION_SECRET are auto-generated if not provided
# You can set them manually if preferred:
# JWT_SECRET=your-custom-jwt-secret
# SESSION_SECRET=your-custom-session-secret
