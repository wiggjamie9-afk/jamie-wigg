# Cloudflare Pages SPA fallback for dynamic [id] routes.
# Next.js static export generates one sentinel page per dynamic route at
# `/plan/_/` and `/render/_/`; any real client-minted id is served by
# rewriting to that sentinel and letting the client component read params.

/plan/*    /plan/_/index.html    200
/render/*  /render/_/index.html  200
