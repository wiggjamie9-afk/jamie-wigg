# Aria Tool Registry Environment Variables
# Copy this file to .env and fill in your API keys

# ===== WEATHER APIs =====
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=
WEATHERSTACK_API_KEY=

# ===== FINANCE APIs =====
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
INTRINIO_API_KEY=

# ===== NEWS APIs =====
NEWSAPI_API_KEY=
MEDIASTACK_API_KEY=
CURRENTS_API_KEY=

# ===== GEOLOCATION APIs =====
IPSTACK_API_KEY=
GEOLOCATION_DB_API_KEY=
MAXMIND_LICENSE_KEY=

# ===== TRANSLATION APIs =====
GOOGLE_TRANSLATE_API_KEY=
MICROSOFT_TRANSLATOR_API_KEY=

# ===== IMAGE/VISION APIs =====
UNSPLASH_API_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=

# ===== SEARCH APIs =====
GOOGLE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
SERPSTACK_API_KEY=

# ===== EMAIL/SMS APIs =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
MAILGUN_API_KEY=

# ===== SOCIAL MEDIA APIs =====
TWITTER_API_KEY=
TWITTER_API_SECRET=
GITHUB_API_TOKEN=
LINKEDIN_API_KEY=

# ===== DATABASE/STORAGE APIs =====
STRIPE_API_KEY=
AIRTABLE_API_KEY=

# ===== TOOL REGISTRY CONFIGURATION =====
# Path to cached tool registry JSON (auto-synced from public-apis)
TOOL_REGISTRY_PATH=packages/aria-core/data/tool-registry.json

# Sync interval (milliseconds, 0 = manual only)
TOOL_REGISTRY_SYNC_INTERVAL=86400000

# Enable validator health checks on sync
TOOL_REGISTRY_VALIDATE=true

# Sample size for endpoint validation (0-100)
TOOL_REGISTRY_SAMPLE_SIZE=15

# ===== ARIA CORE CONFIGURATION =====
# Executor timeout (milliseconds)
ARIA_EXECUTOR_TIMEOUT=5000

# Retry attempts for network errors
ARIA_EXECUTOR_RETRY_COUNT=3

# Delay between retries (milliseconds)
ARIA_EXECUTOR_RETRY_DELAY=1000
