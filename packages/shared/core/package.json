{
  "name": "@ecosystem/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core utilities and types for the ecosystem",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./dist/logger.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "files": ["dist", "src"],
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
