# 9Router Multi-Provider LLM Router
# Copy this file to .env and fill in your API keys

# ===== PROVIDER API KEYS =====
# At least one key is required

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API
GOOGLE_API_KEY=...

# Groq API
GROQ_API_KEY=...

# ===== OPTIONAL: OPENMONO (LOCAL FALLBACK) =====
# OPENMONO_URL=http://localhost:5000
# OPENMONO_API_KEY=local-key
