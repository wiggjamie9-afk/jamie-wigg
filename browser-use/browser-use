#!/usr/bin/env bash
# Tiny wrapper so you can run a web task in one line:
#   ./browser-use/browser-use "go to example.com and tell me the main heading"
# It uses this folder's isolated Python environment automatically.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$HERE/.venv/bin/python" "$HERE/run.py" "$@"
